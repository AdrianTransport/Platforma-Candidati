# Copiaza acest fisier in ".env" si completeaza valorile

# Opțional: OpenAI direct, dezactivat până la aprobarea costurilor și configurare.
# Nu folosi cheia virtuală injectată de Netlify AI Gateway pentru acest câmp.
# Cheia reală se introduce numai în variabilele secrete ale serverului, nu în Git.
PLATFORM_OPENAI_API_KEY=
AI_GENERATION_ENABLED=false
AI_TEXT_DAILY_LIMIT=0
AI_IMAGE_DAILY_LIMIT=0

# Optional: backend alternativ Supabase in loc de Netlify Blobs. Lasa gol
# daca ramai pe Netlify Blobs (implicit).
DATA_BACKEND=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Un text lung, aleatoriu, folosit pentru securitatea sesiunilor de logare.
SESSION_SECRET=schimba-acest-text-cu-unul-lung-si-aleatoriu

# Obligatorii înainte de activarea/comercializarea conturilor de candidat.
# Sunt afișate în paginile juridice publice; nu introduce aici date fictive.
PLATFORM_NAME=VoceaCandidatului
PLATFORM_OPERATOR_NAME=
PLATFORM_OPERATOR_ID=
PLATFORM_LEGAL_EMAIL=
PLATFORM_LEGAL_ADDRESS=

# Numai pentru inițializarea unei instalări fără administrator existent.
# Completează local o parolă unică, aleatorie, de minimum 12 caractere.
# Nu introduce secrete reale în acest fișier versionat.
INITIAL_ADMIN_EMAIL=admin@platforma.ro
INITIAL_ADMIN_PASSWORD=

# Portul pe care ruleaza aplicatia (implicit 3000)
PORT=3000

# Optional: trimitere email pentru "Am uitat parola" (Super Admin), prin Resend.
# Fara ele, linkul "Am uitat parola" arata mereu acelasi mesaj generic, dar
# nu trimite niciun email (nu se blocheaza nimic altceva in platforma).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
