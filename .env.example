# Copiaza acest fisier in ".env" si completeaza valorile

# Cheia de API Anthropic, necesara pentru butonul "Genereaza draft" din dashboard.
# O obtii de la https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Un text lung, aleatoriu, folosit pentru securitatea sesiunilor de logare.
SESSION_SECRET=schimba-acest-text-cu-unul-lung-si-aleatoriu

# Portul pe care ruleaza aplicatia (implicit 3000)
PORT=3000
