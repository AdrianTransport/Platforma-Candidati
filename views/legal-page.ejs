<%- include('partials/vl-top', { seo, section: '' }) %>
<article class="doc glass">
<span class="eyebrow">DOCUMENT OPERAȚIONAL · ACTUALIZAT LA <%= page.updated || termsVersion %></span>
<h1><%= page.title %></h1>
<p class="article__lead"><%= page.intro %></p>
<% if (page.cookies) { %>
<h2>Tehnologiile folosite</h2>
<div class="table-wrap"><table class="table"><thead><tr><th>Nume</th><th>Scop</th><th>Durată</th><th>Categorie</th></tr></thead><tbody>
<% page.cookies.forEach(([name, purpose, duration, category]) => { %><tr><td><code><%= name %></code></td><td><%= purpose %></td><td><%= duration %></td><td><%= category %></td></tr><% }) %>
</tbody></table></div>
<% } %>
<% page.sections.forEach(([title, text]) => { %><h2><%= title %></h2><p><%= text %></p><% }) %>
<h2>Responsabil și contact</h2>
<p><strong>Droc Cristian Dan</strong><% if (platform.legalEmail) { %><br>Email: <a href="mailto:<%= platform.legalEmail %>"><%= platform.legalEmail %></a><% } %><% if (platform.legalAddress) { %><br>Adresă: <%= platform.legalAddress %><% } %></p>
<nav class="legal-links" aria-label="Alte documente"><a href="/legal/statut">Statut editorial</a><a href="/legal/termeni">Termeni</a><a href="/legal/continut">Conținut</a><a href="/legal/confidentialitate">Confidențialitate</a><a href="/legal/cookies">Cookies</a><a href="/legal/raportare">Raportare</a></nav>
</article>
<%- include('partials/vl-bottom', { section: '' }) %>
