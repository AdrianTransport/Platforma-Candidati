<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page.title %> — <%= platform.name %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="public-body">
  <main class="legal-page-shell">
    <a class="back-home" href="/">← Înapoi la platformă</a>
    <span class="eyebrow">Document operațional · versiunea <%= termsVersion %></span>
    <h1><%= page.title %></h1><p class="legal-intro"><%= page.intro %></p>
    <% page.sections.forEach(([title, text]) => { %><section><h2><%= title %></h2><p><%= text %></p></section><% }) %>
    <section class="operator-box"><h2>Responsabil editorial</h2><p><strong>Droc Cristian Dan</strong></p></section>
    <nav class="legal-links"><a href="/legal/statut">Statut editorial</a><a href="/legal/termeni">Termeni</a><a href="/legal/continut">Conținut</a><a href="/legal/confidentialitate">Confidențialitate</a><a href="/legal/raportare">Raportare</a></nav>
  </main>
</body>
</html>
