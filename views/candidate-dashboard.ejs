<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard — <%= user.nume_candidat %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="app-shell app-shell-wide">
    <div class="topbar">
      <div><span class="eyebrow"><%= user.functie_candidatura || 'Candidat' %> · <%= user.zona || 'Zona necompletată' %></span><h1><%= user.nume_candidat %></h1></div>
      <div class="topbar-actions"><% if (user.module?.social) { %><a class="btn" href="/dashboard/social">Centru social</a><% } %><% if (user.module?.site) { %><a class="btn secondary" href="/site/<%= user.subdomeniu %>" target="_blank">Vezi publicația</a><% } %><form method="POST" action="/logout"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button class="secondary" type="submit">Ieșire</button></form></div>
    </div>

    <% if (lipsuriJuridice.length) { %><section class="card legal-warning"><strong>Publicarea materialelor noi este blocată până la completarea juridică.</strong><p>Lipsesc: <%= lipsuriJuridice.join(', ') %>.</p><a class="btn secondary" href="/activare">Verifică activarea și termenii</a></section><% } else { %><section class="card legal-ready"><strong>Profilul juridic și responsabilitatea editorială sunt confirmate.</strong><a href="/site/<%= user.subdomeniu %>/transparenta" target="_blank">Vezi informațiile publice de transparență</a></section><% } %>

    <% if (user.module?.statistici) { %>
      <div class="stats-grid">
        <div><span>Vizite publicație</span><strong><%= user.statistici?.vizite_site || 0 %></strong></div>
        <div><span>Citiri articole</span><strong><%= totalCitiri %></strong></div>
        <div><span>Clickuri sociale</span><strong><%= Object.values(user.statistici?.clickuri_sociale || {}).reduce((a, b) => a + b, 0) %></strong></div>
        <div><span>Articole publicate</span><strong><%= articole.filter(a => isPublished(a)).length %></strong></div>
      </div>
      <div class="dashboard-columns">
        <section class="card"><h2>Sursele vizitelor</h2><div class="source-list"><% Object.entries(user.statistici?.surse || {}).forEach(([sursa, total]) => { %><div><span><%= sursa %></span><strong><%= total %></strong></div><% }) %></div></section>
        <section class="card"><h2>Cele mai citite</h2><% if (!topArticole.length) { %><p class="note">Statisticile apar după primele citiri.</p><% } %><% topArticole.forEach(a => { %><div class="rank-row"><span><%= a.titlu %></span><strong><%= a.vizualizari || 0 %></strong></div><% }) %></section>
      </div>
    <% } %>

    <details class="card profile-card">
      <summary>Profilul public și rețelele sociale</summary>
      <form method="POST" action="/dashboard/profil" class="form-grid form-grid-2">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <label>Slogan<input name="slogan" maxlength="140" value="<%= user.slogan || '' %>" placeholder="Împreună pentru comunitatea noastră"></label>
        <label>Mesaj scurt<input name="mesaj_scurt" maxlength="240" value="<%= user.mesaj_scurt || '' %>" placeholder="Mesajul afișat în antetul publicației"></label>
        <label class="full-field">Prezentare<textarea name="descriere" rows="5" maxlength="2000" placeholder="Cine ești și de ce candidezi"><%= user.descriere || '' %></textarea></label>
        <label>Funcția pentru care candidezi<input name="functie_candidatura" maxlength="120" value="<%= user.functie_candidatura || '' %>"></label>
        <label>Localitate / zonă<input name="zona" maxlength="120" value="<%= user.zona || '' %>"></label>
        <label>Județ<input name="judet" maxlength="80" value="<%= user.judet || '' %>"></label>
        <label>Email de contact public (opțional)<input type="email" name="email_contact" maxlength="254" value="<%= user.email_contact || '' %>"></label>
        <label>Telefon de contact public (opțional)<input type="tel" name="telefon_contact" maxlength="30" value="<%= user.telefon_contact || '' %>"></label>
        <p class="note full-field">Aceste date de contact vor fi vizibile tuturor. Nu se afișează automat adresa de autentificare. Lasă câmpurile goale pentru a retrage contactul public.</p>
        <% if (user.module?.social) { %>
          <label>Facebook<input type="url" name="facebook_url" value="<%= user.facebook_url || '' %>" placeholder="https://facebook.com/..."></label>
          <label>Instagram<input type="url" name="instagram_url" value="<%= user.instagram_url || '' %>" placeholder="https://instagram.com/..."></label>
          <label>TikTok<input type="url" name="tiktok_url" value="<%= user.tiktok_url || '' %>" placeholder="https://tiktok.com/@..."></label>
          <label>YouTube<input type="url" name="youtube_url" value="<%= user.youtube_url || '' %>" placeholder="https://youtube.com/@..."></label>
        <% } %>
        <div class="form-actions"><button type="submit">Salvează profilul</button></div>
      </form>
    </details>

    <section class="editorial-section-dashboard" aria-labelledby="sectiuni-editoriale">
      <div class="section-row"><div><span class="eyebrow">Conținutul site-ului</span><h2 id="sectiuni-editoriale">Administrează fiecare pagină din meniu</h2></div></div>
      <div class="editorial-section-grid">
        <% sectiuniEditoriale.forEach(section => { %><article class="card editorial-section-card">
          <span class="eyebrow"><%= section.publicate %> publicate · <%= section.total %> total</span>
          <h3><%= section.titlu %></h3><p><%= section.descriere %></p>
          <div><a class="btn" href="/dashboard/articol/nou?categorie=<%= encodeURIComponent(section.categorie) %>">+ Adaugă <%= section.slug === 'proiecte' ? 'proiect' : 'material' %></a><a class="btn secondary" href="/site/<%= user.subdomeniu %>/<%= section.slug %>" target="_blank">Vezi pagina</a></div>
        </article><% }) %>
      </div>
    </section>

    <div class="card content-toolbar"><div><strong>Toate materialele mele</strong><p>Textele și imaginile pot fi scrise manual sau pregătite cu OpenAI înainte de publicare.</p></div><a class="btn" href="/dashboard/articol/nou">+ Material nou</a></div>
    <div class="card table-card">
      <form class="dashboard-filters" method="GET" action="/dashboard">
        <label>Rubrică<select name="categorie"><option value="">Toate rubricile</option><% categoriiDashboard.forEach(categorie => { %><option value="<%= categorie %>" <%= categorieFiltru === categorie ? 'selected' : '' %>><%= categorie %></option><% }) %></select></label>
        <label>Status<select name="status"><option value="">Toate statusurile</option><option value="ciorna" <%= statusFiltru === 'ciorna' ? 'selected' : '' %>>Ciornă</option><option value="programat" <%= statusFiltru === 'programat' ? 'selected' : '' %>>Programat</option><option value="publicat" <%= statusFiltru === 'publicat' ? 'selected' : '' %>>Publicat</option><option value="suspendat" <%= statusFiltru === 'suspendat' ? 'selected' : '' %>>Suspendat</option></select></label>
        <button type="submit" class="secondary">Filtrează</button>
        <% if (categorieFiltru || statusFiltru) { %><a href="/dashboard">Resetează</a><span class="filter-result"><%= rezultatTotal %> din <%= totalArticole %> materiale</span><% } %>
      </form>
      <% if (articole.length === 0) { %><p class="note"><%= totalArticole ? 'Niciun material nu corespunde filtrelor selectate.' : 'Nu ai niciun material încă.' %></p><% } else { %>
        <div class="responsive-table"><table><thead><tr><th>Titlu</th><th>Categorie</th><th>Status</th><th>Citiri</th><th>Acțiuni</th></tr></thead><tbody>
          <% articole.forEach(a => { const publicHref = a.categorie === 'Proiecte' ? `/site/${user.subdomeniu}/proiect/${a.id}` : `/site/${user.subdomeniu}/articol/${a.id}`; %><tr>
            <td><strong><%= a.titlu %></strong><% if (a.generat_de_ai) { %> <span class="pill ai">AI</span><% } %><% if (a.distribuiri_sociale?.length) { %> <span class="pill social-count"><%= a.distribuiri_sociale.length %> distribuiri</span><% } %></td>
            <td><%= a.categorie %></td>
            <td><% if (a.moderation_status === 'suspendat') { %><span class="pill suspendat">Suspendat</span><small class="schedule-label"><%= a.moderation_reason || 'În analiză' %></small><% } else { %><span class="pill <%= isPublished(a) ? 'publicat' : a.status %>"><%= isPublished(a) ? 'Publicat' : (a.status === 'programat' ? 'Programat' : 'Ciornă') %></span><% if (a.status === 'programat') { %><small class="schedule-label"><%= displayDate(a.data_programata) %> · ora României</small><% } %><% } %></td>
            <td><%= a.vizualizari || 0 %></td>
            <td class="actions-cell"><div class="material-actions"><a class="btn secondary" href="/dashboard/articol/<%= a.id %>/preview" target="_blank" rel="noopener">Previzualizează</a><% if (isPublished(a) && a.moderation_status !== 'suspendat') { %><a class="btn secondary" href="<%= publicHref %>" target="_blank" rel="noopener">Vezi public</a><% } %><a class="btn secondary" href="/dashboard/articol/<%= a.id %>/edit">Editează</a><form method="POST" action="/dashboard/articol/<%= a.id %>/sterge" onsubmit="return confirm('Sigur ștergi acest articol?')"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button class="danger" type="submit">Șterge</button></form></div></td>
          </tr><% }) %>
        </tbody></table></div>
      <% } %>
    </div>
  </div>
</body>
</html>
