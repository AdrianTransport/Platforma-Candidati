<% const legalReady = !lipsuriJuridice.length; const totalClickuriSociale = Object.values(user.statistici?.clickuri_sociale || {}).reduce((a, b) => a + b, 0); %>
<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard — <%= user.nume_candidat %></title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/candidate-ui.css">
</head>
<body class="candidate-app-body">
  <header class="candidate-app-header">
    <a class="candidate-brand" href="/dashboard" aria-label="Vocea Candidatului — dashboard">
      <span class="candidate-brand-mark" aria-hidden="true">V</span>
      <span><strong>Vocea</strong>Candidatului</span>
    </a>
    <div class="candidate-account">
      <div class="candidate-account-copy">
        <strong><%= user.nume_candidat %></strong>
        <span><%= user.functie_candidatura || 'Candidat' %></span>
      </div>
      <span class="candidate-avatar" aria-hidden="true"><%= (user.nume_candidat || 'C').trim().charAt(0).toUpperCase() %></span>
      <form method="POST" action="/logout">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <button class="candidate-logout" type="submit">Ieșire</button>
      </form>
    </div>
  </header>

  <div class="candidate-app-layout">
    <%- include('partials/candidate-sidebar', { user, activePage: 'overview', legalReady }) %>

    <main class="candidate-main">
      <% if (mesaj) { %><div class="candidate-alert success"><div><strong><%= mesaj %></strong></div></div><% } %>
      <% if (eroare) { %><div class="candidate-alert warning"><div><strong><%= eroare %></strong></div></div><% } %>
      <section class="candidate-welcome">
        <div>
          <span class="candidate-kicker">Panoul candidatului</span>
          <h1>Bun venit, <%= user.nume_candidat %></h1>
          <p>Administrează publicația, pregătește materiale și urmărește rezultatele dintr-un singur loc.</p>
        </div>
        <div class="candidate-quick-actions">
          <a class="candidate-btn primary" href="/dashboard/articol/nou">+ Material nou</a>
          <% if (user.module?.site) { %><a class="candidate-btn secondary" href="/site/<%= user.subdomeniu %>" target="_blank" rel="noopener">Vezi publicația</a><% } %>
        </div>
      </section>

      <section class="candidate-panel poll-manager"><span class="candidate-kicker">Engagement comunitate</span><h2>Sondaj pe publicația ta</h2><p>Publică o întrebare scurtă. Nu se colectează numele sau emailul vizitatorilor.</p><form method="POST" action="/dashboard/sondaje" class="form-grid form-grid-2"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><label>Întrebare<input name="intrebare" maxlength="180" required placeholder="Care este prioritatea ta pentru cartier?"></label><label>Opțiuni, una pe fiecare rând<textarea name="optiuni" rows="4" required placeholder="Curățenie&#10;Spații verzi&#10;Siguranță"></textarea></label><label class="consent-label full-field"><input type="checkbox" name="rezultate_publice" checked> Arată rezultatele și vizitatorilor</label><div class="form-actions"><button class="candidate-btn primary" type="submit">Publică sondajul</button></div></form><div class="poll-admin-list"><% sondaje.forEach(poll => { const total = poll.options.reduce((sum, option) => sum + option.votes, 0); %><article><div><strong><%= poll.question %></strong><small><%= total %> voturi · <%= poll.active ? 'activ' : 'închis' %></small><ul class="poll-owner-results"><% poll.options.forEach(option => { %><li><span><%= option.text %></span><strong><%= option.votes %> · <%= total ? Math.round(option.votes * 100 / total) : 0 %>%</strong></li><% }) %></ul></div><form method="POST" action="/sondaje/<%= poll.id %>/stare"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="active" value="<%= poll.active ? 'false' : 'true' %>"><button class="candidate-btn secondary" type="submit"><%= poll.active ? 'Închide' : 'Reactivează' %></button></form></article><% }) %></div></section>

      <% if (!legalReady) { %>
        <section class="candidate-alert warning" role="alert">
          <span class="candidate-alert-icon" aria-hidden="true">!</span>
          <div><strong>Publicarea este momentan blocată</strong><p>Completează datele lipsă: <%= lipsuriJuridice.join(', ') %>.</p></div>
          <a href="/activare">Verifică activarea</a>
        </section>
      <% } else { %>
        <section class="candidate-alert success">
          <span class="candidate-alert-icon" aria-hidden="true">✓</span>
          <div><strong>Contul este pregătit pentru publicare</strong><p>Datele juridice și responsabilitatea editorială sunt confirmate.</p></div>
          <a href="/site/<%= user.subdomeniu %>/transparenta" target="_blank" rel="noopener">Vezi transparența</a>
        </section>
      <% } %>

      <% if (user.module?.statistici) { %>
        <section class="candidate-stats" aria-label="Statistici publicație">
          <article class="candidate-stat-card"><span>Vizite publicație</span><strong><%= user.statistici?.vizite_site || 0 %></strong><small>Vizitatori înregistrați</small></article>
          <article class="candidate-stat-card"><span>Citiri articole</span><strong><%= totalCitiri %></strong><small>Totalul materialelor citite</small></article>
          <article class="candidate-stat-card"><span>Clickuri sociale</span><strong><%= totalClickuriSociale %></strong><small>Accesări către rețele</small></article>
          <article class="candidate-stat-card"><span>Articole publicate</span><strong><%= articole.filter(a => isPublished(a)).length %></strong><small>Vizibile în publicație</small></article>
        </section>

        <section class="candidate-insights">
          <article class="candidate-panel">
            <div class="candidate-panel-heading"><div><span class="candidate-kicker">Audiență</span><h2>Sursele vizitelor</h2></div></div>
            <div class="candidate-source-list"><% Object.entries(user.statistici?.surse || {}).forEach(([sursa, total]) => { %><div><span><%= sursa %></span><strong><%= total %></strong></div><% }) %></div>
          </article>
          <article class="candidate-panel">
            <div class="candidate-panel-heading"><div><span class="candidate-kicker">Performanță</span><h2>Cele mai citite</h2></div></div>
            <% if (!topArticole.length) { %><p class="candidate-empty">Statisticile apar după primele citiri.</p><% } %>
            <div class="candidate-ranking"><% topArticole.forEach((a, index) => { %><div><span class="candidate-rank"><%= index + 1 %></span><span><%= a.titlu %></span><strong><%= a.vizualizari || 0 %></strong></div><% }) %></div>
          </article>
        </section>
      <% } %>

      <section class="candidate-content-section" aria-labelledby="sectiuni-editoriale">
        <div class="candidate-section-heading">
          <div><span class="candidate-kicker">Conținutul site-ului</span><h2 id="sectiuni-editoriale">Administrează fiecare pagină din meniu</h2></div>
        </div>
        <div class="candidate-section-grid">
          <% sectiuniEditoriale.forEach(section => { %>
            <article class="candidate-section-card">
              <div class="candidate-section-count"><strong><%= section.publicate %></strong><span>publicate</span></div>
              <h3><%= section.titlu %></h3>
              <p><%= section.descriere %></p>
              <div class="candidate-card-actions">
                <a class="candidate-btn primary small" href="/dashboard/articol/nou?categorie=<%= encodeURIComponent(section.categorie) %>">+ Adaugă <%= section.slug === 'proiecte' ? 'proiect' : 'material' %></a>
                <a class="candidate-text-link" href="/site/<%= user.subdomeniu %>/<%= section.slug %>" target="_blank" rel="noopener">Vezi pagina</a>
              </div>
            </article>
          <% }) %>
        </div>
      </section>

      <section class="candidate-profile candidate-panel" id="profil-public">
        <details>
          <summary><span><span class="candidate-kicker">Date publice</span><strong>Profilul public și rețelele sociale</strong></span><span class="candidate-summary-action">Editează profilul</span></summary>
          <form method="POST" action="/dashboard/profil" class="candidate-form-grid">
            <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
            <label>Slogan<input name="slogan" maxlength="140" value="<%= user.slogan || '' %>" placeholder="Împreună pentru comunitatea noastră"></label>
            <label>Mesaj scurt<input name="mesaj_scurt" maxlength="240" value="<%= user.mesaj_scurt || '' %>" placeholder="Mesajul afișat în antetul publicației"></label>
            <label class="full-field">Prezentare<textarea name="descriere" rows="5" maxlength="2000" placeholder="Cine ești și de ce candidezi"><%= user.descriere || '' %></textarea></label>
            <label>Funcția pentru care candidezi<input name="functie_candidatura" maxlength="120" value="<%= user.functie_candidatura || '' %>"></label>
            <label>Localitate / zonă<input name="zona" maxlength="120" value="<%= user.zona || '' %>"></label>
            <label>Județ<input name="judet" maxlength="80" value="<%= user.judet || '' %>"></label>
            <label>Email de contact public (opțional)<input type="email" name="email_contact" maxlength="254" value="<%= user.email_contact || '' %>"></label>
            <label>Telefon de contact public (opțional)<input type="tel" name="telefon_contact" maxlength="30" value="<%= user.telefon_contact || '' %>"></label>
            <p class="candidate-form-note full-field">Datele de contact devin publice. Adresa folosită pentru autentificare nu este afișată automat.</p>
            <% if (user.module?.social) { %>
              <label>Facebook<input type="url" name="facebook_url" value="<%= user.facebook_url || '' %>" placeholder="https://facebook.com/..."></label>
              <label>Instagram<input type="url" name="instagram_url" value="<%= user.instagram_url || '' %>" placeholder="https://instagram.com/..."></label>
              <label>TikTok<input type="url" name="tiktok_url" value="<%= user.tiktok_url || '' %>" placeholder="https://tiktok.com/@..."></label>
              <label>YouTube<input type="url" name="youtube_url" value="<%= user.youtube_url || '' %>" placeholder="https://youtube.com/@..."></label>
            <% } %>
            <div class="candidate-form-actions"><button class="candidate-btn primary" type="submit">Salvează profilul</button></div>
          </form>
        </details>
      </section>

      <section class="candidate-materials" id="materiale" aria-labelledby="titlu-materiale">
        <div class="candidate-section-heading">
          <div><span class="candidate-kicker">Redacție</span><h2 id="titlu-materiale">Materialele mele</h2><p>Scrie manual sau pregătește conținutul cu OpenAI, apoi verifică-l înainte de publicare.</p></div>
          <a class="candidate-btn primary" href="/dashboard/articol/nou">+ Material nou</a>
        </div>

        <div class="candidate-panel candidate-material-panel">
          <form class="candidate-filters" method="GET" action="/dashboard">
            <label>Rubrică<select name="categorie"><option value="">Toate rubricile</option><% categoriiDashboard.forEach(categorie => { %><option value="<%= categorie %>" <%= categorieFiltru === categorie ? 'selected' : '' %>><%= categorie %></option><% }) %></select></label>
            <label>Status<select name="status"><option value="">Toate statusurile</option><option value="ciorna" <%= statusFiltru === 'ciorna' ? 'selected' : '' %>>Ciornă</option><option value="programat" <%= statusFiltru === 'programat' ? 'selected' : '' %>>Programat</option><option value="publicat" <%= statusFiltru === 'publicat' ? 'selected' : '' %>>Publicat</option><option value="suspendat" <%= statusFiltru === 'suspendat' ? 'selected' : '' %>>Suspendat</option></select></label>
            <button type="submit" class="candidate-btn secondary">Filtrează</button>
            <% if (categorieFiltru || statusFiltru) { %><a class="candidate-text-link" href="/dashboard">Resetează</a><span class="candidate-filter-result"><%= rezultatTotal %> din <%= totalArticole %> materiale</span><% } %>
          </form>

          <% if (articole.length === 0) { %>
            <div class="candidate-empty-state"><strong><%= totalArticole ? 'Nu există rezultate pentru filtrele alese.' : 'Nu ai niciun material încă.' %></strong><p>Începe cu o idee, un proiect sau o știre pentru comunitate.</p><a class="candidate-btn primary small" href="/dashboard/articol/nou">Creează primul material</a></div>
          <% } else { %>
            <div class="candidate-table-wrap"><table class="candidate-material-table"><thead><tr><th>Titlu</th><th>Categorie</th><th>Status</th><th>Citiri</th><th>Acțiuni</th></tr></thead><tbody>
              <% articole.forEach(a => { const publicHref = a.categorie === 'Proiecte' ? `/site/${user.subdomeniu}/proiect/${a.id}` : `/site/${user.subdomeniu}/articol/${a.id}`; %><tr>
                <td data-label="Titlu"><strong><%= a.titlu %></strong><div class="candidate-table-badges"><% if (a.generat_de_ai) { %><span class="candidate-badge ai">AI</span><% } %><% if (a.distribuiri_sociale?.length) { %><span class="candidate-badge neutral"><%= a.distribuiri_sociale.length %> distribuiri</span><% } %></div></td>
                <td data-label="Categorie"><%= a.categorie %></td>
                <td data-label="Status"><% if (a.moderation_status === 'suspendat') { %><span class="candidate-badge danger">Suspendat</span><small><%= a.moderation_reason || 'În analiză' %></small><% } else { %><span class="candidate-badge <%= isPublished(a) ? 'success' : a.status %>"><%= isPublished(a) ? 'Publicat' : (a.status === 'programat' ? 'Programat' : 'Ciornă') %></span><% if (a.status === 'programat') { %><small><%= displayDate(a.data_programata) %> · ora României</small><% } %><% } %></td>
                <td data-label="Citiri"><%= a.vizualizari || 0 %></td>
                <td data-label="Acțiuni"><div class="candidate-material-actions"><a href="/dashboard/articol/<%= a.id %>/preview" target="_blank" rel="noopener">Previzualizează</a><% if (isPublished(a) && a.moderation_status !== 'suspendat') { %><a href="<%= publicHref %>" target="_blank" rel="noopener">Vezi public</a><% } %><a href="/dashboard/articol/<%= a.id %>/edit">Editează</a><form method="POST" action="/dashboard/articol/<%= a.id %>/sterge" onsubmit="return confirm('Sigur ștergi acest articol?')"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button type="submit">Șterge</button></form></div></td>
              </tr><% }) %>
            </tbody></table></div>
          <% } %>
        </div>
      </section>
    </main>
  </div>
</body>
</html>
