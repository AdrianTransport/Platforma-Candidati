<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <title>Dashboard - <%= user.nume_candidat %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="app-shell">
    <div class="topbar">
      <div>
        <h1><%= user.nume_candidat %></h1>
        <p class="note" style="margin:2px 0 0">
          Site public: <a href="/site/<%= user.subdomeniu %>" target="_blank">/site/<%= user.subdomeniu %></a>
        </p>
      </div>
      <form method="POST" action="/logout"><button class="secondary" type="submit">Iesire</button></form>
    </div>

    <div class="card" style="display:flex; justify-content:space-between; align-items:center">
      <div>
        <strong>Documentele si ideile mele</strong>
        <p class="note" style="margin:4px 0 0">Ce apare aici cu status "Publicat" e vizibil pe site-ul tau public.</p>
      </div>
      <a class="btn" href="/dashboard/articol/nou">+ Adauga articol</a>
    </div>

    <div class="card">
      <% if (articole.length === 0) { %>
        <p class="note">Nu ai niciun articol inca. Apasa "Adauga articol" ca sa incepi.</p>
      <% } else { %>
        <table>
          <thead><tr><th>Titlu</th><th>Tip</th><th>Categorie</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% articole.forEach(a => { %>
              <tr>
                <td>
                  <%= a.titlu %>
                  <% if (a.generat_de_ai) { %><span class="pill ai">AI</span><% } %>
                </td>
                <td><%= a.tip %></td>
                <td><%= a.categorie %></td>
                <td><span class="pill <%= a.status %>"><%= a.status === 'publicat' ? 'Publicat' : 'Ciorna' %></span></td>
                <td style="white-space:nowrap">
                  <a class="btn secondary" href="/dashboard/articol/<%= a.id %>/edit">Editeaza</a>
                  <form style="display:inline" method="POST" action="/dashboard/articol/<%= a.id %>/sterge" onsubmit="return confirm('Sigur stergi acest articol?')">
                    <button class="danger" type="submit">Sterge</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</body>
</html>
