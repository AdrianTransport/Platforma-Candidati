<!DOCTYPE html>
<html lang="ro">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="description" content="Prezentarea candidatului <%= user.nume_candidat %>."><meta property="og:type" content="profile"><meta property="og:title" content="Despre <%= user.nume_candidat %>"><meta property="og:description" content="<%= user.mesaj_scurt || user.slogan || `Prezentarea candidatului ${user.nume_candidat}.` %>"><meta property="og:url" content="<%= pageUrl %>"><meta name="twitter:card" content="summary"><title>Despre candidat — <%= user.nume_candidat %></title><link rel="stylesheet" href="<%= stylesheetUrl %>"><link rel="stylesheet" href="/newspaper.css"><link rel="stylesheet" href="/candidate-site.css?v=20260911-name1"></head>
<body class="newspaper-body candidate-design"><div class="candidate-site-shell">
  <%- include('partials/candidate-header', { user, activeSection }) %>
  <main id="candidate-main">
    <section class="candidate-hero candidate-about-hero"><div class="candidate-container candidate-hero-grid"><div class="candidate-hero-copy"><span class="candidate-eyebrow">Despre candidat</span><h1><%= user.nume_candidat %></h1><p class="candidate-hero-role"><%= [user.functie_candidatura,user.zona || user.judet].filter(Boolean).join(' · ') %></p><% if(user.mesaj_scurt || user.slogan){ %><p class="candidate-hero-message"><%= user.mesaj_scurt || user.slogan %></p><% } %><div class="candidate-actions"><a class="candidate-button" href="/site/<%= user.subdomeniu %>/program">Vezi programul candidatului</a><a class="candidate-button candidate-button-outline" href="/site/<%= user.subdomeniu %>/contact">Contact</a></div></div><div class="candidate-hero-visual"><div class="candidate-portrait-frame<%= user.fotografie_profil_url ? ' candidate-portrait-frame-photo' : '' %>"><% if(user.fotografie_profil_url){ %><img src="<%= publicImageUrl(user.fotografie_profil_url) %>" alt="<%= user.nume_candidat %>" width="640" height="640" fetchpriority="high" decoding="async"><% } else { %><span class="candidate-portrait-initials"><%= user.nume_candidat.split(' ').map(p=>p[0]).slice(0,2).join('') %></span><% } %></div></div></div></section>
    <section class="candidate-container candidate-biography"><aside><span class="candidate-eyebrow">Profil</span><h2>Pe scurt</h2><dl class="candidate-profile-facts"><% if(user.functie_candidatura){ %><div><dt>Candidează pentru</dt><dd><%= user.functie_candidatura %></dd></div><% } %><% if(user.zona || user.judet){ %><div><dt>Comunitate</dt><dd><%= [user.zona,user.judet].filter(Boolean).join(', ') %></dd></div><% } %><% if(user.partid){ %><div><dt>Formațiune / statut</dt><dd><%= user.partid %></dd></div><% } %></dl><%- include('partials/candidate-party', { user }) %></aside><article><span class="candidate-eyebrow">Prezentare</span><h2>Despre mine</h2><div class="candidate-biography-text"><% (user.descriere || 'Prezentarea candidatului va fi publicată aici.').split('\n').filter(p=>p.trim()).forEach(paragraf=>{ %><p><%= paragraf %></p><% }) %></div><a class="candidate-text-link" href="/site/<%= user.subdomeniu %>/proiecte">Descoperă proiectele →</a></article></section>
    <% if(user.fotografie_coperta_url){ %><figure class="candidate-container candidate-cover-figure"><img src="<%= user.fotografie_coperta_url %>" alt="Imagine de copertă — <%= user.zona || user.nume_candidat %>" width="1200" height="600" loading="lazy" decoding="async"></figure><% } %>
  </main>
  <% const transparenta = publicTransparency(user, null); %>
  <section class="political-ad-banner <%= electoralMode ? '' : 'civic-disclosure' %>" aria-label="Informații despre responsabilitatea editorială"><strong><%= electoralMode ? 'Material electoral · publicitate politică' : 'Publicație civică independentă' %></strong><span><%= electoralMode ? `Finanțat de ${transparenta.finantat_de} · ` : '' %>publicat și asumat de <%= transparenta.responsabil_editorial %></span><a href="/site/<%= user.subdomeniu %>/transparenta">Vezi transparența completă</a></section>
  <%- include('partials/candidate-footer', { user }) %>
</div><%- include('partials/cristianweb-credit') %></body></html>
