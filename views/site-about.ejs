<!DOCTYPE html>
<html lang="ro">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="description" content="Prezentarea candidatului <%= user.nume_candidat %>."><title>Despre candidat — <%= user.nume_candidat %></title><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/newspaper.css"></head>
<body class="newspaper-body"><div class="newspaper-shell">
  <div class="newspaper-kicker"><span>PUBLICAȚIE ELECTORALĂ</span><span><%= [user.zona, user.judet].filter(Boolean).join(' · ') %></span></div>
  <header class="newspaper-header"><a href="/site/<%= user.subdomeniu %>" class="newspaper-logo"><span><%= user.nume_candidat.split(' ')[0] %></span><strong>JURNAL</strong></a><div class="candidate-identity"><strong><%= user.nume_candidat %></strong><span><%= [user.functie_candidatura, user.partid].filter(Boolean).join(' · ') %></span></div></header>
  <%- include('partials/candidate-nav', { user, activeSection }) %>
  <% const transparenta = publicTransparency(user, null); %>
  <section class="political-ad-banner" aria-label="Informații despre publicitatea politică"><strong>Material electoral · publicitate politică</strong><span>Finanțat de <%= transparenta.finantat_de %> · publicat și asumat de <%= transparenta.responsabil_editorial %></span><a href="/site/<%= user.subdomeniu %>/transparenta">Vezi transparența completă</a></section>
  <main class="about-page"><div class="candidate-monogram"><%= user.nume_candidat.split(' ').map(p => p[0]).slice(0,2).join('') %></div><article><span class="article-label">Despre candidat</span><h1><%= user.nume_candidat %></h1><p class="about-lead"><%= user.mesaj_scurt || user.slogan || 'Pentru comunitate.' %></p><div class="about-text"><% (user.descriere || 'Prezentarea candidatului va fi publicată aici.').split('\n').filter(p => p.trim()).forEach(paragraf => { %><p><%= paragraf %></p><% }) %></div><dl class="candidate-facts"><% if (user.functie_candidatura) { %><div><dt>Candidează pentru</dt><dd><%= user.functie_candidatura %></dd></div><% } %><% if (user.zona || user.judet) { %><div><dt>Comunitate</dt><dd><%= [user.zona, user.judet].filter(Boolean).join(', ') %></dd></div><% } %><% if (user.partid) { %><div><dt>Formațiune / statut</dt><dd><%= user.partid %></dd></div><% } %></dl><a class="btn" href="/site/<%= user.subdomeniu %>/program">Vezi programul candidatului</a></article></main>
  <footer class="newspaper-footer"><div><strong><%= user.nume_candidat %></strong><span><%= user.slogan || 'Pentru comunitate.' %></span></div><p>Prezentare publicată și asumată de candidat. Material electoral finanțat de <%= transparenta.finantat_de %>.</p><nav class="footer-links"><a href="/site/<%= user.subdomeniu %>/contact">Contact</a><a href="/site/<%= user.subdomeniu %>/transparenta">Transparență</a><a href="/legal/termeni">Termeni</a><a href="/">VoceaCandidatului</a></nav></footer>
</div></body></html>
