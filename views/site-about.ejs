<!DOCTYPE html>
<html lang="ro">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="description" content="Prezentarea candidatului <%= user.nume_candidat %>."><meta property="og:type" content="profile"><meta property="og:title" content="Despre <%= user.nume_candidat %>"><meta property="og:description" content="<%= user.mesaj_scurt || user.slogan || `Prezentarea candidatului ${user.nume_candidat}.` %>"><meta property="og:url" content="<%= pageUrl %>"><meta name="twitter:card" content="summary"><title>Despre candidat — <%= user.nume_candidat %></title><link rel="stylesheet" href="<%= stylesheetUrl %>"><link rel="stylesheet" href="/newspaper.css"></head>
<body class="newspaper-body"><div class="newspaper-shell">
  <div class="newspaper-kicker"><span>VOCEA CANDIDATULUI · <%= electoralMode ? 'PUBLICAȚIE ELECTORALĂ' : 'PUBLICAȚIE CIVICĂ' %></span><span><%= [user.zona, user.judet].filter(Boolean).join(' · ') %></span></div>
  <header class="newspaper-header"><a href="/site/<%= user.subdomeniu %>" class="newspaper-logo voice-logo" aria-label="Vocea Candidatului — pagina principală"><span>Vocea</span><strong>Candidatului</strong></a><div class="candidate-identity"><strong><%= user.nume_candidat %></strong><span><%= [user.functie_candidatura, user.partid].filter(Boolean).join(' · ') %></span></div></header>
  <%- include('partials/candidate-nav', { user, activeSection }) %>
  <% const transparenta = publicTransparency(user, null); %>
  <section class="political-ad-banner <%= electoralMode ? '' : 'civic-disclosure' %>" aria-label="Informații despre responsabilitatea editorială"><strong><%= electoralMode ? 'Material electoral · publicitate politică' : 'Publicație civică independentă' %></strong><span><%= electoralMode ? `Finanțat de ${transparenta.finantat_de} · ` : '' %>publicat și asumat de <%= transparenta.responsabil_editorial %></span><a href="/site/<%= user.subdomeniu %>/transparenta">Vezi transparența completă</a></section>
  <main class="about-page"><div class="candidate-monogram"><%= user.nume_candidat.split(' ').map(p => p[0]).slice(0,2).join('') %></div><article><span class="article-label">Despre candidat</span><h1><%= user.nume_candidat %></h1><p class="about-lead"><%= user.mesaj_scurt || user.slogan || 'Pentru comunitate.' %></p><div class="about-text"><% (user.descriere || 'Prezentarea candidatului va fi publicată aici.').split('\n').filter(p => p.trim()).forEach(paragraf => { %><p><%= paragraf %></p><% }) %></div><dl class="candidate-facts"><% if (user.functie_candidatura) { %><div><dt>Candidează pentru</dt><dd><%= user.functie_candidatura %></dd></div><% } %><% if (user.zona || user.judet) { %><div><dt>Comunitate</dt><dd><%= [user.zona, user.judet].filter(Boolean).join(', ') %></dd></div><% } %><% if (user.partid) { %><div><dt>Formațiune / statut</dt><dd><%= user.partid %></dd></div><% } %></dl><a class="btn" href="/site/<%= user.subdomeniu %>/program">Vezi programul candidatului</a></article></main>
  <footer class="newspaper-footer"><div><strong><%= user.nume_candidat %></strong><span><%= user.slogan || 'Pentru comunitate.' %></span></div><p>Prezentare publicată și asumată de candidat.<% if (electoralMode) { %> Material electoral finanțat de <%= transparenta.finantat_de %>.<% } %></p><nav class="footer-links"><a href="/site/<%= user.subdomeniu %>/contact">Contact</a><a href="/site/<%= user.subdomeniu %>/transparenta">Transparență</a><a href="/legal/termeni">Termeni</a><a href="/legal/confidentialitate">Confidențialitate</a><a href="/legal/cookies">Cookies</a><a href="/">Vocea Locală Lenauheim</a></nav></footer>
</div><%- include('partials/cristianweb-credit') %></body></html>
