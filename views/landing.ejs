<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Vocea Locală Lenauheim — știri, inițiative și publicațiile candidaților din Bulgăruș, Lenauheim și Grabaț.">
  <title>Vocea Locală Lenauheim — știri și inițiative din comună</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="public-body portal-public-body">
  <header class="portal-news-header">
    <a class="platform-brand local-brand" href="/"><span>Vocea Locală</span><strong>Lenauheim</strong></a>
    <nav><a href="#stiri">Știri</a><a href="#campanii">Campanii</a><a href="#candidati">Candidați</a><a href="#despre">Despre platformă</a><a class="btn secondary" href="/login">Autentificare</a></nav>
  </header>

  <main>
    <div class="portal-edition-bar"><span>PUBLICAȚIE DIGITALĂ LOCALĂ</span><time><%= new Intl.DateTimeFormat('ro-RO', { dateStyle: 'full', timeZone: 'Europe/Bucharest' }).format(new Date()) %></time><span>BULGĂRUȘ · LENAUHEIM · GRABAȚ</span></div>

    <section class="local-identity-banner" aria-labelledby="local-identity-title">
      <div class="local-identity-copy"><span class="eyebrow">Vocea comunității</span><h1 id="local-identity-title">Bulgăruș · Lenauheim · Grabaț</h1><p>Știri, proiecte și inițiative din toate cele trei localități ale comunei, într-un singur loc.</p></div>
      <div class="local-map"><iframe title="Harta localităților Bulgăruș, Lenauheim și Grabaț" loading="lazy" src="https://www.openstreetmap.org/export/embed.html?bbox=20.72%2C45.83%2C20.90%2C45.96&amp;layer=mapnik&amp;marker=45.8904%2C20.799" referrerpolicy="no-referrer-when-downgrade"></iframe><a href="https://www.openstreetmap.org/?mlat=45.8904&amp;mlon=20.799#map=12/45.8904/20.799" target="_blank" rel="noopener">Deschide harta mărită ↗</a></div>
    </section>

    <% if (principal) { %>
      <section class="portal-lead">
        <a class="portal-lead-image" href="/actualitate/<%= principal.slug %>">
          <% if (principal.imagine_url) { %><img src="<%= principal.imagine_url %>" alt="<%= principal.imagine_alt || '' %>"><% } else { %><span><%= principal.tip === 'campanie' ? 'CAMPANIE' : 'ACTUALITATE' %></span><% } %>
        </a>
        <div class="portal-lead-copy"><span class="portal-section-label"><%= principal.tip === 'campanie' ? 'Campanie candidat' : principal.categorie %></span><h1><a href="/actualitate/<%= principal.slug %>"><%= principal.titlu %></a></h1><p><%= principal.rezumat %></p><% if (principal.candidat) { %><strong><%= principal.candidat.nume_candidat %> · <%= principal.candidat.functie_candidatura %></strong><% } %><a class="portal-read-more" href="/actualitate/<%= principal.slug %>">Citește materialul →</a></div>
      </section>
    <% } else { %>
      <section class="marketing-hero portal-empty-hero"><div><span class="eyebrow">Platformă pentru campanii electorale locale</span><h1>Știrile și ideile candidaților ajung mai ușor la comunitate.</h1><p>Un portal public administrat de Super Admin, publicații distincte pentru candidați și informații clare despre responsabilitate și finanțare.</p><div class="hero-actions"><a class="btn btn-accent" href="#candidati">Vezi candidații</a><a class="btn secondary" href="/login">Intră în cont</a></div></div><div class="hero-preview"><div class="preview-head"><strong>COMUNITATEA</strong><span>EDIȚIE LOCALĂ</span></div><div class="preview-main"><span>ACTUALITATE</span><h2>Prima știre va apărea aici</h2><p>Super Adminul controlează integral conținutul site-ului principal.</p></div><div class="preview-grid"><i></i><i></i><i></i></div></div></section>
    <% } %>

    <section class="portal-news-section" id="stiri">
      <div class="portal-section-head"><div><span class="eyebrow">Actualitate</span><h2>Ultimele știri</h2></div><p>Informații publicate de operatorul platformei.</p></div>
      <% if (!stiri.length) { %><div class="empty-public">Nu există încă alte știri publicate.</div><% } else { %><div class="portal-card-grid"><% stiri.forEach(post => { %><article class="portal-news-card"><a class="portal-card-image" href="/actualitate/<%= post.slug %>"><% if (post.imagine_url) { %><img src="<%= post.imagine_url %>" alt="<%= post.imagine_alt || '' %>"><% } else { %><span>ȘTIRE</span><% } %></a><div><span class="portal-section-label"><%= post.categorie %></span><h3><a href="/actualitate/<%= post.slug %>"><%= post.titlu %></a></h3><p><%= post.rezumat %></p><small><%= displayDate(portalPublicationDate(post)) %> · <%= post.vizualizari || 0 %> citiri</small></div></article><% }) %></div><% } %>
    </section>

    <section class="portal-campaign-section" id="campanii">
      <div class="portal-section-head"><div><span class="eyebrow">Promovare transparentă</span><h2>Campaniile candidaților</h2></div><p>Fiecare material indică beneficiarul, finanțatorul și responsabilul editorial.</p></div>
      <% if (!campanii.length) { %><div class="empty-public dark-empty">Nu există încă alte campanii publicate.</div><% } else { %><div class="portal-campaign-grid"><% campanii.forEach(post => { %><article><span>CAMPANIE CANDIDAT</span><h3><a href="/actualitate/<%= post.slug %>"><%= post.titlu %></a></h3><p><%= post.rezumat %></p><% if (post.candidat) { %><div class="campaign-candidate"><strong><%= post.candidat.nume_candidat %></strong><small><%= [post.candidat.functie_candidatura, post.candidat.zona].filter(Boolean).join(' · ') %></small></div><% } %><small>Finanțat de: <%= post.finantator %></small><a href="/actualitate/<%= post.slug %>">Citește campania →</a></article><% }) %></div><% } %>
    </section>
    <% if (sondaj) { %><section class="published-section portal-poll-section" id="sondaj"><%- include('partials/poll', { poll: sondaj }) %></section><% } %>

    <section class="published-section" id="candidati">
      <div class="portal-section-head"><div><span class="eyebrow">Publicații independente</span><h2>Site-urile candidaților</h2></div><p>Fiecare candidat își administrează și își asumă propria publicație.</p></div>
      <% if (!candidatiPublici.length) { %><div class="empty-public">Primul site de candidat va apărea aici după activare.</div><% } else { %><div class="candidate-showcase"><% candidatiPublici.forEach(c => { %><a href="/site/<%= c.subdomeniu %>"><span><%= c.functie_candidatura || 'Candidat' %></span><strong><%= c.nume_candidat %></strong><small><%= [c.zona, c.judet].filter(Boolean).join(', ') %></small><em>Deschide publicația →</em></a><% }) %></div><p class="showcase-all"><a class="btn secondary" href="/candidati">Vezi și filtrează toți candidații</a></p><% } %>
    </section>

    <section class="marketing-section" id="despre"><div class="section-heading"><span class="eyebrow">Platformă completă</span><h2>Comunicare electorală organizată, simplă și transparentă.</h2></div><div class="feature-grid"><article><span>01</span><h3>Portal administrat</h3><p>Super Adminul publică știri, campanii și articolul principal.</p></article><article><span>02</span><h3>Site tip ziar</h3><p>Fiecare candidat are propriul site cu program, proiecte și articole.</p></article><article><span>03</span><h3>Text și imagini</h3><p>Editor manual și instrumente OpenAI disponibile după activarea administratorului.</p></article><article><span>04</span><h3>Statistici clare</h3><p>Citiri și surse generale de trafic, fără profilarea politică a alegătorilor.</p></article></div></section>
  </main>

  <footer class="marketing-footer"><strong>Vocea Locală Lenauheim</strong><span>Platformă tehnică operată de <%= platform.operatorName %>. Materialele candidaților sunt marcate separat și păstrează datele de transparență.</span><nav class="legal-links"><a href="/legal/termeni">Termeni</a><a href="/legal/continut">Conținut</a><a href="/legal/confidentialitate">Confidențialitate</a><a href="/legal/raportare">Raportare</a><a href="/login">Administrare</a></nav></footer>
</body>
</html>
