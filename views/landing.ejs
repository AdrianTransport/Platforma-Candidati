<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Vocea Locală Lenauheim — știri, inițiative și publicațiile candidaților din Bulgăruș, Lenauheim și Grabaț.">
  <title>Vocea Locală Lenauheim — știri și inițiative din comună</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="public-body portal-public-body">
  <header class="portal-modern-masthead">
    <p>O comunitate mai informată,<br>mai puternică</p>
    <a class="portal-modern-logo" href="/"><strong>Vocea Locală Lenauheim</strong><span>Bulgăruș · Lenauheim · Grabaț</span></a>
    <div class="portal-masthead-side"><span class="portal-village-mark" aria-hidden="true">⌂♙</span><small>Știri locale.<br>Oameni. Idei. Viitor comun.</small><div class="public-social-icons"><% [['facebook','f',portalOwner?.facebook_url],['instagram','◎',portalOwner?.instagram_url],['tiktok','♪',portalOwner?.tiktok_url]].forEach(([network,icon,url])=>{ %><% if(url){ %><a class="social-icon <%= network %>" href="<%= url %>" target="_blank" rel="noopener noreferrer" aria-label="<%= network %>"><%= icon %></a><% } else { %><span class="social-icon <%= network %> is-unconfigured" title="Se configurează din Super Admin" aria-label="<%= network %> neconfigurat"><%= icon %></span><% } %><% }) %></div></div>
  </header>
  <nav class="portal-modern-nav" aria-label="Meniul principal"><a href="/">⌂</a><a href="/sectiune/stiri">Știri</a><a href="/sectiune/administratie">Administrație</a><a href="/sectiune/comunitate">Comunitate</a><a href="/sectiune/educatie">Educație</a><a href="/sectiune/economie">Economie</a><a href="/candidati">Oameni</a><a href="/sectiune/evenimente">Timp liber</a><a href="/login" class="portal-nav-login">Administrare</a></nav>

  <main>
    <% if (principal) { %>
      <section class="portal-modern-lead">
        <a class="portal-modern-lead-main" href="/actualitate/<%= principal.slug %>" <% if(principal.imagine_url){ %>style="background-image:linear-gradient(0deg,rgba(1,20,31,.88),rgba(1,20,31,0) 72%),url('<%= principal.imagine_url %>')"<% } %>><div><span><%= principal.tip === 'campanie' ? 'Campanie candidat' : (principal.categorie || 'Actualitate') %></span><h1><%= principal.titlu %></h1><p><%= principal.rezumat %></p><time><%= displayDate(portalPublicationDate(principal)) %></time></div></a>
        <div class="portal-modern-side-news"><% stiri.slice(0,3).forEach(post=>{ %><a href="/actualitate/<%= post.slug %>"><% if(post.imagine_url){ %><img src="<%= post.imagine_url %>" alt="<%= post.imagine_alt || '' %>"><% } else { %><span class="portal-side-placeholder">VL</span><% } %><div><small><%= post.categorie %></small><strong><%= post.titlu %></strong><time><%= displayDate(portalPublicationDate(post)) %></time></div></a><% }) %><% if(!stiri.length){ [['Educație','Noutăți din școlile și comunitatea noastră','educatie'],['Infrastructură','Drumuri, utilități și proiecte locale','administratie'],['Oameni','Povești și inițiative din comună','comunitate']].forEach(item=>{ %><a href="/sectiune/<%= item[2] %>"><span class="portal-side-placeholder"><%= item[0].slice(0,1) %></span><div><small><%= item[0] %></small><strong><%= item[1] %></strong><time>Descoperă rubrica →</time></div></a><% }) } %></div>
      </section>
    <% } else { %>
      <section class="marketing-hero portal-empty-hero"><div><span class="eyebrow">Platformă civică pentru comunitatea locală</span><h1>Știrile și ideile candidaților ajung mai ușor la comunitate.</h1><p>Un portal public administrat de Super Admin, publicații civice distincte pentru candidați și informații clare despre responsabilitatea editorială.</p><div class="hero-actions"><a class="btn btn-accent" href="#candidati">Vezi candidații</a><a class="btn secondary" href="/login">Intră în cont</a></div></div><div class="hero-preview"><div class="preview-head"><strong>COMUNITATEA</strong><span>EDIȚIE LOCALĂ</span></div><div class="preview-main"><span>ACTUALITATE</span><h2>Prima știre va apărea aici</h2><p>Super Adminul controlează integral conținutul site-ului principal.</p></div><div class="preview-grid"><i></i><i></i><i></i></div></div></section>
    <% } %>

    <section class="portal-community-row">
      <div class="portal-community-poll"><% if (sondaj) { %><%- include('partials/poll', { poll: sondaj }) %><% } else { %><span class="eyebrow">Sondajul comunității</span><h2>Spune-ne ce contează pentru tine</h2><p>Super Adminul poate publica aici o întrebare pentru locuitorii comunei.</p><a href="/login">Administrare sondaj →</a><% } %></div>
      <div class="portal-active-people"><header><h2>Cei mai activi candidați în comunitate</h2><a href="/candidati">Vezi toți candidații →</a></header><div><% candidatiPublici.slice(0,4).forEach(c=>{ %><a href="/site/<%= c.subdomeniu %>"><span class="portal-person-photo"><% if(c.fotografie_profil_url){ %><img src="<%= c.fotografie_profil_url %>" alt="<%= c.nume_candidat %>"><% } else { %><b><%= c.nume_candidat.split(' ').map(p=>p[0]).slice(0,2).join('') %></b><% } %></span><strong><%= c.nume_candidat %></strong><small><%= c.zona || c.judet %></small><em>Vezi profilul →</em></a><% }) %></div></div>
    </section>

    <section class="portal-community-signature"><div class="portal-community-photo" role="img" aria-label="Panoramă a comunității Lenauheim"></div><blockquote>Trei localități.<br><strong>O singură comunitate.</strong></blockquote><span class="portal-village-mark" aria-hidden="true">⌂♙</span><p><strong>Bulgăruș · Lenauheim · Grabaț.</strong><br>Oameni care construiesc împreună o comunitate mai bună.</p></section>

    <section class="portal-news-section" id="stiri">
      <div class="portal-section-head"><div><span class="eyebrow">Actualitate</span><h2>Ultimele știri</h2></div><p>Informații publicate de operatorul platformei.</p></div>
      <% if (!stiri.length) { %><div class="empty-public">Nu există încă alte știri publicate.</div><% } else { %><div class="portal-card-grid"><% stiri.forEach(post => { %><article class="portal-news-card"><a class="portal-card-image" href="/actualitate/<%= post.slug %>"><% if (post.imagine_url) { %><img src="<%= post.imagine_url %>" alt="<%= post.imagine_alt || '' %>"><% } else { %><span>ȘTIRE</span><% } %></a><div><span class="portal-section-label"><%= post.categorie %></span><h3><a href="/actualitate/<%= post.slug %>"><%= post.titlu %></a></h3><p><%= post.rezumat %></p><small><%= displayDate(portalPublicationDate(post)) %> · <%= post.vizualizari || 0 %> citiri</small></div></article><% }) %></div><% } %>
    </section>

    <section class="portal-campaign-section" id="campanii">
      <div class="portal-section-head"><div><span class="eyebrow">Promovare transparentă</span><h2>Campaniile candidaților</h2></div><p>Fiecare material indică beneficiarul, finanțatorul și responsabilul editorial.</p></div>
      <% if (!campanii.length) { %><div class="empty-public dark-empty">Nu există încă alte campanii publicate.</div><% } else { %><div class="portal-campaign-grid"><% campanii.forEach(post => { %><article><span>CAMPANIE CANDIDAT</span><h3><a href="/actualitate/<%= post.slug %>"><%= post.titlu %></a></h3><p><%= post.rezumat %></p><% if (post.candidat) { %><div class="campaign-candidate"><strong><%= post.candidat.nume_candidat %></strong><small><%= [post.candidat.functie_candidatura, post.candidat.zona].filter(Boolean).join(' · ') %></small></div><% } %><small>Finanțat de: <%= post.finantator %></small><a href="/actualitate/<%= post.slug %>">Citește campania →</a></article><% }) %></div><% } %>
    </section>
    <section class="published-section" id="candidati">
      <div class="portal-section-head"><div><span class="eyebrow">Publicații independente</span><h2>Site-urile candidaților</h2></div><p>Fiecare candidat își administrează și își asumă propria publicație.</p></div>
      <% if (!candidatiPublici.length) { %><div class="empty-public">Primul site de candidat va apărea aici după activare.</div><% } else { %><div class="candidate-showcase"><% candidatiPublici.forEach(c => { %><a href="/site/<%= c.subdomeniu %>"><span><%= c.functie_candidatura || 'Candidat' %></span><strong><%= c.nume_candidat %></strong><small><%= [c.zona, c.judet].filter(Boolean).join(', ') %></small><em>Deschide publicația →</em></a><% }) %></div><p class="showcase-all"><a class="btn secondary" href="/candidati">Vezi și filtrează toți candidații</a></p><% } %>
    </section>

    <% const portalSocial = [['facebook', portalOwner?.facebook_url], ['instagram', portalOwner?.instagram_url], ['tiktok', portalOwner?.tiktok_url]].filter(([, url]) => url); %>
    <% if (portalSocial.length) { %><section class="portal-social-strip" aria-label="Rețelele sociale Vocea Locală"><strong>Urmărește Vocea Locală Lenauheim</strong><div><% portalSocial.forEach(([network, url]) => { %><a href="<%= url %>" target="_blank" rel="noopener noreferrer"><%= network %></a><% }) %></div></section><% } %>

    <section class="marketing-section" id="despre"><div class="section-heading"><span class="eyebrow">Platformă completă</span><h2>Comunicare civică organizată, simplă și transparentă.</h2></div><div class="feature-grid"><article><span>01</span><h3>Portal administrat</h3><p>Super Adminul publică știri, inițiative și articolul principal.</p></article><article><span>02</span><h3>Site tip ziar</h3><p>Fiecare candidat are propriul site cu program, proiecte și articole.</p></article><article><span>03</span><h3>Text și imagini</h3><p>Editor manual și instrumente OpenAI disponibile după activarea administratorului.</p></article><article><span>04</span><h3>Statistici clare</h3><p>Citiri și surse generale de trafic, fără profilarea politică a vizitatorilor.</p></article></div></section>
  </main>

  <footer class="marketing-footer"><strong>Vocea Locală Lenauheim</strong><span>Platformă tehnică operată de <%= platform.operatorName %>. Materialele candidaților sunt marcate separat și păstrează datele de transparență.</span><nav class="legal-links"><a href="/legal/termeni">Termeni</a><a href="/legal/continut">Conținut</a><a href="/legal/confidentialitate">Confidențialitate</a><a href="/legal/raportare">Raportare</a><a href="/login">Administrare</a></nav></footer>
<script>document.querySelectorAll('.portal-news-card,.portal-campaign-grid article').forEach(card=>{const link=card.querySelector('a[href]');if(!link)return;card.tabIndex=0;card.setAttribute('role','link');card.addEventListener('click',event=>{if(!event.target.closest('a,button'))location.href=link.href;});card.addEventListener('keydown',event=>{if(event.key==='Enter')location.href=link.href;});});</script>
</body>
</html>
