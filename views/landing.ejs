<%- include('partials/vl-top', { seo, section: 'procese', blobs: 'home' }) %>
<% if (hero) { %>
<%- include('partials/vl-hero', { view: hero }) %>
<section id="live" class="live-row" aria-label="Actualizări și dosare">
<%- include('partials/vl-feed', { view: hero }) %>
<%- include('partials/vl-cases', { cases }) %>
</section>
<% } else { %>
<section class="hero hero--intro">
<div class="hero__main">
<div class="hero__meta"><span class="badge badge--upcoming"><span class="badge__dot" aria-hidden="true"></span>PROCESE CU PRIMĂRIA</span></div>
<h1>Știrile comunei, procesele cu Primăria, urmărite live</h1>
<p class="hero__lead">Vocea Locală Lenauheim: știri verificate, anunțuri și procesele în care e parte Primăria, din Bulgăruș, Lenauheim și Grabaț.</p>
<div class="hero__actions"><a class="btn btn--dark" href="/sectiune/stiri">Citește știrile</a><a class="btn btn--light" href="/anunturi">Anunțuri</a></div>
</div>
</section>
<% if (cases.length) { %><section id="live" class="live-row" aria-label="Dosare"><%- include('partials/vl-cases', { cases }) %></section><% } %>
<% } %>

<section class="stack" id="stiri" aria-labelledby="ultimele-stiri">
<div class="section-head"><h2 class="section-title" id="ultimele-stiri">Ultimele știri</h2><a href="/sectiune/stiri">Toate știrile →</a></div>
<% if (principal) { const side = stiri.slice(0, 2); %>
<div class="lead-row">
<article class="lead<%= principal.imagine_url ? "" : " lead--plain" %>">
<% if (principal.imagine_url) { %><img class="lead__img" src="<%= principal.imagine_url %>" alt="<%= principal.imagine_alt || '' %>" width="1200" height="800" decoding="async"<% if (!hero) { %> fetchpriority="high"<% } else { %> loading="lazy"<% } %>><% } %>
<div class="lead__box">
<span class="chip <%= principal.tip === 'campanie' ? 'cat-campanie' : 'cat-' + toneOf(principal.categorie) %>"><%= principal.tip === 'campanie' ? 'Campanie candidat' : (principal.categorie || 'Actualitate') %></span>
<h3 class="lead__title"><a href="/actualitate/<%= encodeURIComponent(principal.slug) %>"><%= principal.titlu %></a></h3>
<% if (principal.rezumat) { %><p class="lead__summary"><%= principal.rezumat %></p><% } %>
<span class="byline"><% if (principal.candidat) { %><%= principal.candidat.nume_candidat %> · <% } %><time datetime="<%= seoDateOf(principal) %>"><%= displayDate(portalPublicationDate(principal)) %></time> · <%= principal.vizualizari || 0 %> citiri</span>
</div>
</article>
<% if (side.length) { %>
<div class="side-list">
<% for (const post of side) { %>
<article class="side-card glass">
<span class="chip cat-<%= toneOf(post.categorie) %>"><%= post.categorie || 'Actualitate' %></span>
<h3><a href="/actualitate/<%= encodeURIComponent(post.slug) %>"><%= post.titlu %></a></h3>
<time datetime="<%= seoDateOf(post) %>"><%= displayDate(portalPublicationDate(post)) %></time>
</article>
<% } %>
</div>
<% } %>
</div>
<% } %>
<% const rest = [...stiri.slice(principal ? 2 : 0), ...campanii]; %>
<% if (rest.length) { %>
<div class="cards">
<% for (const post of rest) { %><%- include('partials/vl-card', { post }) %><% } %>
</div>
<% } else if (!principal) { %>
<div class="cards">
<% [['Administrație', 'Decizii publice și proiecte din comună', 'administratie'], ['Comunitate', 'Oameni și inițiative din cele trei sate', 'comunitate'], ['Educație', 'Noutăți din școli și grădinițe', 'educatie']].forEach(([label, text, slug]) => { %>
<article class="card card--grid"><div class="card__img ph" aria-hidden="true">vocea lenauheim</div><div class="card__body"><span class="card__kicker tone-<%= toneOf(label) %>"><%= label %></span><h3><a href="/sectiune/<%= slug %>"><%= text %></a></h3><span class="card__meta">Descoperă rubrica →</span></div></article>
<% }) %>
</div>
<% } %>
</section>

<section class="community-row" aria-label="Comunitate">
<div class="panel glass community-poll" id="sondaj">
<% if (sondaj) { %><%- include('partials/poll', { poll: sondaj }) %>
<% } else { %><span class="eyebrow">SONDAJUL COMUNITĂȚII</span><h2>Spune-ne ce contează pentru tine</h2><p class="muted">Aici apare întrebarea săptămânii pentru locuitorii comunei. Votul este anonim.</p><a class="btn btn--light" href="/anunturi">Între timp, vezi anunțurile →</a><% } %>
</div>
<div class="community-card">
<img class="portal-community-photo" src="/assets/lenauheim-panorama-v1-640.webp" srcset="/assets/lenauheim-panorama-v1-640.webp 640w, /assets/lenauheim-panorama-v1.webp 1000w" sizes="(max-width: 760px) 92vw, 600px" alt="Panoramă a comunității Lenauheim" width="1000" height="417" loading="lazy" decoding="async">
<div class="community-card__text">
<p class="community-card__quote">Trei localități.<br><strong>O singură comunitate.</strong></p>
<p>Bulgăruș · Lenauheim · Grabaț. Oameni care construiesc împreună o comunitate mai bună.</p>
</div>
</div>
</section>

<section class="costs glass" aria-labelledby="costuri-titlu">
<div><span class="eyebrow">RAPORTARE CETĂȚENEASCĂ</span><h2 id="costuri-titlu">Cât plătești pe apă și salubritate?</h2><p class="muted">Raportezi anonim în mai puțin de un minut. Publicăm doar intervale, pe localități.</p></div>
<div class="costs__actions"><a class="btn btn--dark" href="/statistici/apa">Rezultate apă</a><a class="btn btn--light" href="/statistici/salubritate">Rezultate salubritate</a></div>
</section>

<section class="stack" id="candidati" aria-labelledby="candidati-titlu">
<div class="section-head"><h2 class="section-title" id="candidati-titlu">Site-urile candidaților</h2><% if (candidatiPublici.length) { %><a href="/candidati">Toți candidații →</a><% } %></div>
<p class="muted">Publicații independente: fiecare candidat își administrează și își asumă propriul site.</p>
<% if (!candidatiPublici.length) { %><p class="empty glass">Site-urile candidaților apar aici când Super Adminul activează afișarea în portal.</p>
<% } else { %>
<div class="people">
<% candidatiPublici.forEach(c => { %><a class="person glass" href="/site/<%= c.subdomeniu %>"><span class="person__role"><%= c.functie_candidatura || 'Candidat' %></span><b><%= c.nume_candidat %></b><span class="person__place"><%= [c.zona, c.judet].filter(Boolean).join(', ') %></span><span class="person__more">Deschide publicația →</span></a><% }) %>
</div>
<% } %>
</section>

<% const portalSocial = [['Facebook', portalOwner?.facebook_url], ['Instagram', portalOwner?.instagram_url], ['TikTok', portalOwner?.tiktok_url]].filter(([, url]) => url); %>
<% if (portalSocial.length) { %><section class="social-strip" aria-label="Rețelele sociale Vocea Locală"><b>Urmărește Vocea Locală Lenauheim</b><div><% portalSocial.forEach(([network, url]) => { %><a class="btn btn--light" href="<%= url %>" target="_blank" rel="noopener noreferrer"><%= network %></a><% }) %></div></section><% } %>

<section class="stack" id="despre" aria-labelledby="despre-titlu">
<div class="section-head"><h2 class="section-title" id="despre-titlu">Comunicare civică, simplă și transparentă</h2></div>
<div class="features">
<article class="feature glass"><span class="mono">01</span><h3>Portal administrat</h3><p>Redacția publică știri, inițiative, anunțuri și urmărește procesele cu Primăria.</p></article>
<article class="feature glass"><span class="mono">02</span><h3>Site tip ziar</h3><p>Fiecare candidat are propriul site, cu program, proiecte și articole.</p></article>
<article class="feature glass"><span class="mono">03</span><h3>Text și imagini</h3><p>Editor manual și instrumente OpenAI, disponibile după activarea administratorului.</p></article>
<article class="feature glass"><span class="mono">04</span><h3>Statistici clare</h3><p>Citiri și surse generale de trafic, fără profilarea politică a vizitatorilor.</p></article>
</div>
</section>
<%- include('partials/vl-bottom', { section: 'procese', live: Boolean(hero), portalCards: true }) %>
