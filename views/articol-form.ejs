<% const esteProiect = articol?.categorie === 'Proiecte'; const titluFormular = articol?.id ? (esteProiect ? 'Editează proiectul' : 'Editează materialul') : (esteProiect ? 'Proiect nou' : 'Material nou'); %>
<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titluFormular %></title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/editorial-editor.css">
</head>
<body>
  <div class="app-shell">
    <div class="topbar">
      <h1><%= titluFormular %></h1>
      <a class="btn secondary" href="/dashboard">Inapoi la dashboard</a>
    </div>

    <div class="editorial-workspace" data-account="<%= userId %>">
    <aside class="card editor-assistant">
      <span class="editor-eyebrow">Asistent editorial</span>
      <h2>Text și imagini cu OpenAI</h2>
      <p class="note">Descrie subiectul și faptele confirmate pentru rubrica <strong><%= articol?.categorie || 'Actualitate' %></strong>. Propunerile nu se publică automat și nu îți înlocuiesc textul până nu le aplici.</p>
      <label for="idee-ai">Tema articolului sau a ilustrației</label>
      <textarea id="idee-ai" rows="6" maxlength="4000" placeholder="Ce vrei să explici? Ce informații sunt verificate? Pentru imagine, descrie o scenă ilustrată, fără a o prezenta drept un eveniment real."></textarea>
      <label for="ton-ai">Tonul textului</label>
      <select id="ton-ai">
        <option value="clar și informativ">Clar și informativ</option>
        <option value="direct și apropiat">Direct și apropiat</option>
        <option value="oficial și formal">Oficial și formal</option>
      </select>
      <label class="editor-consent"><input type="checkbox" id="acord-ai"> Sunt de acord să trimit aceste informații către OpenAI pentru generare. Nu includ date confidențiale sau date personale ale altor persoane.</label>
      <div class="ai-actions"><button type="button" id="btn-genereaza" disabled>Generează articol</button><button type="button" class="secondary" id="btn-imagine-ai" disabled>Generează ilustrație</button></div>
      <p class="note" id="config-ai" role="status">Verific disponibilitatea generării…</p>
      <p class="note" id="stare-ai" role="status" aria-live="polite"></p>
      <button type="button" class="secondary" id="reia-ai" hidden>Verifică din nou rezultatul</button>
      <section class="ai-proposal" id="ai-result" hidden aria-label="Propunere AI">
        <h3 id="ai-title"></h3><p id="ai-summary"></p><div id="ai-text"></div>
        <img id="ai-image" alt="Previzualizare a ilustrației generate cu AI" hidden>
        <p class="note" id="ai-checks"></p><button type="button" id="aplica-ai">Aplică propunerea în articol</button>
      </section>
      <p class="note">Ilustrațiile sunt marcate ca AI. Generarea are costuri API și este disponibilă numai după activarea de către administrator.</p>
    </aside>

    <div class="card editor-article">
      <% if (eroare) { %><p class="eroare" role="alert"><%= eroare %></p><% } %>
      <form method="POST" action="<%= articol?.id ? `/dashboard/articol/${articol.id}` : '/dashboard/articol' %>">
        <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
        <label>Titlu</label>
        <input type="text" name="titlu" id="titlu" maxlength="200" required value="<%= articol ? articol.titlu : '' %>">
        <label for="rezumat">Rezumat introductiv</label>
        <textarea name="rezumat" id="rezumat" rows="3" maxlength="300" placeholder="Ideea principală, în una sau două fraze."><%= articol?.rezumat || '' %></textarea>

        <label>Tip</label>
        <select name="tip">
          <option value="idee" <%= articol && articol.tip === 'idee' ? 'selected' : '' %>>Idee / poziție</option>
          <option value="candidatura" <%= articol && articol.tip === 'candidatura' ? 'selected' : '' %>>Candidatura oficiala (program)</option>
          <option value="anunt" <%= articol && articol.tip === 'anunt' ? 'selected' : '' %>>Anunț</option>
        </select>

        <label>Pagina în care va apărea materialul</label>
        <select name="categorie">
          <option value="Actualitate" <%= articol && articol.categorie === 'Actualitate' ? 'selected' : '' %>>Actualitate</option>
          <option value="Program" <%= articol && articol.categorie === 'Program' ? 'selected' : '' %>>Program</option>
          <option value="Anunț" <%= articol && articol.categorie === 'Anunț' ? 'selected' : '' %>>Anunț</option>
          <option value="Opinie" <%= articol && articol.categorie === 'Opinie' ? 'selected' : '' %>>Opinie</option>
          <option value="Proiecte" <%= articol && articol.categorie === 'Proiecte' ? 'selected' : '' %>>Proiecte</option>
          <option value="Evenimente" <%= articol && articol.categorie === 'Evenimente' ? 'selected' : '' %>>Evenimente</option>
          <option value="Comunitate" <%= articol && articol.categorie === 'Comunitate' ? 'selected' : '' %>>Comunitate</option>
          <option value="Video" <%= articol && articol.categorie === 'Video' ? 'selected' : '' %>>Video</option>
        </select>

        <label>Continut</label>
        <textarea name="continut" id="continut" rows="10" maxlength="30000" required><%= articol ? articol.continut : '' %></textarea>
        <p class="note">Pentru un subtitlu, începe un rând cu „## ”. Textul este afișat în siguranță, fără cod HTML.</p>

        <fieldset class="editor-media"><legend>Fotografia articolului</legend>
          <label for="fisier-imagine">Încarcă o fotografie</label>
          <input type="file" id="fisier-imagine" accept="image/jpeg,image/png,image/webp">
          <label class="editor-consent"><input type="checkbox" id="acord-imagine"> Am dreptul să folosesc și să public această imagine.</label>
          <button type="button" class="secondary" id="incarca-imagine">Încarcă fotografia selectată</button>
          <p class="note" id="stare-imagine" role="status" aria-live="polite">PNG, JPEG sau WebP. Fotografia este redimensionată în browser și salvată în Netlify Blobs, maximum 3 MB. Nu devine publică până nu publici un articol care o folosește.</p>
          <label for="imagine-url">Sau folosește adresa unei imagini publice</label>
          <input type="text" name="imagine_url" id="imagine-url" maxlength="2048" value="<%= articol?.imagine_url || '' %>" placeholder="https://exemplu.ro/fotografie.jpg">
          <figure class="editor-image-preview" id="image-preview" hidden><img id="preview-image" alt="Previzualizare a fotografiei articolului"><figcaption>Imaginea selectată pentru articol</figcaption></figure>
          <label for="imagine-alt">Descriere pentru accesibilitate</label><input id="imagine-alt" name="imagine_alt" maxlength="240" value="<%= articol?.imagine_alt || '' %>" placeholder="Descrie pe scurt ce se vede în imagine.">
          <label for="imagine-legenda">Legendă sub imagine</label><input id="imagine-legenda" name="imagine_legenda" maxlength="300" value="<%= articol?.imagine_legenda || '' %>">
          <label for="imagine-credit">Autor / sursa imaginii</label><input id="imagine-credit" name="imagine_credit" maxlength="160" value="<%= articol?.imagine_credit || '' %>">
          <label class="editor-consent"><input type="checkbox" name="imagine_generata_ai" id="imagine-generata-ai" value="true" <%= articol?.imagine_generata_ai ? 'checked' : '' %>> Imagine generată cu AI (se afișează o etichetă publică).</label>
        </fieldset>

        <label style="display:flex; align-items:center; gap:8px; font-weight:400">
          <input type="checkbox" name="generat_de_ai" id="generat_de_ai" value="true" style="width:auto; margin:0"
            <%= articol && articol.generat_de_ai ? 'checked' : '' %>>
          Text creat cu ajutorul AI (se afișează o etichetă pe site). Verific faptele și îmi asum conținutul înainte de publicare.
        </label>

        <section class="editor-compliance">
          <strong>Responsabilitate și transparență</strong>
          <p class="note">La publicare sau programare se salvează o copie a finanțatorului, responsabilului editorial, scrutinului, codului mandatarului și datelor contractuale. Ciornele pot fi salvate fără această confirmare.</p>
          <label class="consent-label"><input type="checkbox" name="confirmare_responsabilitate" <%= confirmareResponsabilitate ? 'checked' : '' %>> Confirm că materialul respectă legea și contractul, că am dreptul să folosesc textele și imaginile și că datele de transparență ale contului sunt corecte.</label>
          <% if (articol?.moderation_status === 'suspendat') { %><p class="eroare">Material suspendat de Super Admin: <%= articol.moderation_reason || 'sesizare în analiză' %>. Îl poți salva doar ca ciornă până la restabilire.</p><% } %>
        </section>

        <label for="data-programata">Data și ora publicării programate (ora României)</label>
        <input id="data-programata" type="datetime-local" name="data_programata" value="<%= dataProgramata %>" aria-describedby="schedule-help">
        <p id="schedule-help" class="note">Europe/Bucharest, inclusiv schimbarea orei de vară. Articolul devine vizibil pe site la termen, fără publicare automată pe rețelele sociale. Data este folosită doar de butonul „Programează”.</p>
        <div class="publication-actions">
          <button type="submit" name="status" value="ciorna">Salveaza ca ciorna</button>
          <button type="submit" name="status" value="programat" class="secondary">Programează</button>
          <button type="submit" name="status" value="publicat" class="secondary">Publica pe site</button>
        </div>
      </form>
    </div>
    </div>
  </div>

  <script src="/editorial-editor.js" defer></script>
</body>
</html>
