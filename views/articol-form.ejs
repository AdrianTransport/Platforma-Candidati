<% const esteProiect = articol?.categorie === 'Proiecte'; const titluFormular = articol?.id ? (esteProiect ? 'Editează proiectul' : 'Editează materialul') : (esteProiect ? 'Proiect nou' : 'Material nou'); %>
<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titluFormular %></title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/candidate-ui.css">
  <link rel="stylesheet" href="/editorial-editor.css">
</head>
<body class="candidate-app-body candidate-editor-page">
  <header class="candidate-app-header">
    <a class="candidate-brand" href="/dashboard" aria-label="Vocea Candidatului — dashboard"><span class="candidate-brand-mark" aria-hidden="true">V</span><span><strong>Vocea</strong>Candidatului</span></a>
    <div class="candidate-account">
      <div class="candidate-account-copy"><strong><%= user.nume_candidat %></strong><span><%= user.functie_candidatura || 'Candidat' %></span></div>
      <span class="candidate-avatar" aria-hidden="true"><%= (user.nume_candidat || 'C').trim().charAt(0).toUpperCase() %></span>
      <form method="POST" action="/logout"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button class="candidate-logout" type="submit">Ieșire</button></form>
    </div>
  </header>

  <div class="candidate-app-layout">
    <%- include('partials/candidate-sidebar', { user, activePage: 'materials', legalReady }) %>

    <main class="candidate-main candidate-editor-main">
      <div class="candidate-editor-heading">
        <div><a class="candidate-back-link" href="/dashboard#materiale">← Înapoi la materiale</a><span class="candidate-kicker"><%= articol?.categorie || 'Actualitate' %></span><h1><%= titluFormular %></h1><p>Parcurge pașii, verifică rezultatul și alege tu când materialul devine public.</p></div>
        <% if (articol?.id) { %><a class="candidate-btn secondary" href="/dashboard/articol/<%= articol.id %>/preview" target="_blank" rel="noopener">Previzualizează</a><% } %>
      </div>

      <ol class="editor-steps" aria-label="Etapele materialului">
        <li class="active" data-editor-step="1"><span>1</span><div><strong>Ideea</strong><small>Subiect și informații</small></div></li>
        <li data-editor-step="2"><span>2</span><div><strong>Generare</strong><small>Asistent OpenAI</small></div></li>
        <li data-editor-step="3"><span>3</span><div><strong>Verificare</strong><small>Text, imagine și surse</small></div></li>
        <li data-editor-step="4"><span>4</span><div><strong>Publicare</strong><small>Ciornă, programare sau site</small></div></li>
      </ol>

      <div class="editorial-workspace" data-account="<%= userId %>" data-editor-context="candidate">
        <div class="editor-article">
          <% if (eroare) { %><p class="eroare editor-form-error" role="alert"><%= eroare %></p><% } %>
          <form method="POST" action="<%= articol?.id ? `/dashboard/articol/${articol.id}` : '/dashboard/articol' %>">
            <input type="hidden" name="csrf_token" value="<%= csrfToken %>">

            <section class="editor-card editor-form-section" aria-labelledby="editor-date">
              <div class="editor-section-heading"><span class="editor-section-number">1</span><div><span class="editor-eyebrow">Ideea materialului</span><h2 id="editor-date">Scrie informațiile de bază</h2><p>Poți completa manual sau poți folosi asistentul OpenAI din panoul alăturat.</p></div></div>
              <div class="editor-fields">
                <label for="titlu">Titlu</label>
                <input type="text" name="titlu" id="titlu" maxlength="200" required value="<%= articol ? articol.titlu : '' %>" placeholder="Un titlu clar și concret">

                <label for="rezumat">Rezumat introductiv</label>
                <textarea name="rezumat" id="rezumat" rows="3" maxlength="300" placeholder="Ideea principală, în una sau două fraze."><%= articol?.rezumat || '' %></textarea>

                <div class="editor-field-row">
                  <label>Tip<select name="tip" id="tip-material"><option value="idee" <%= articol && articol.tip === 'idee' ? 'selected' : '' %>>Idee / poziție</option><option value="candidatura" <%= articol && articol.tip === 'candidatura' ? 'selected' : '' %>>Candidatura oficiala (program)</option><option value="anunt" <%= articol && articol.tip === 'anunt' ? 'selected' : '' %>>Anunț</option></select></label>
                  <label>Pagina în care va apărea materialul<select name="categorie"><option value="Actualitate" <%= articol && articol.categorie === 'Actualitate' ? 'selected' : '' %>>Actualitate</option><option value="Program" <%= articol && articol.categorie === 'Program' ? 'selected' : '' %>>Program</option><option value="Anunț" <%= articol && articol.categorie === 'Anunț' ? 'selected' : '' %>>Anunț</option><option value="Opinie" <%= articol && articol.categorie === 'Opinie' ? 'selected' : '' %>>Opinie</option><option value="Proiecte" <%= articol && articol.categorie === 'Proiecte' ? 'selected' : '' %>>Proiecte</option><option value="Evenimente" <%= articol && articol.categorie === 'Evenimente' ? 'selected' : '' %>>Evenimente</option><option value="Comunitate" <%= articol && articol.categorie === 'Comunitate' ? 'selected' : '' %>>Comunitate</option><option value="Video" <%= articol && articol.categorie === 'Video' ? 'selected' : '' %>>Video</option></select></label>
                </div>

                <label for="continut">Conținut</label>
                <textarea name="continut" id="continut" rows="13" maxlength="30000" required placeholder="Dezvoltă aici materialul. Pentru un subtitlu, începe un rând cu ##"><%= articol ? articol.continut : '' %></textarea>
                <p class="editor-help">Pentru un subtitlu, începe un rând cu „## ”. Textul este afișat în siguranță, fără cod HTML.</p>
              </div>
            </section>

            <section class="editor-card editor-form-section" aria-labelledby="editor-media-title">
              <div class="editor-section-heading"><span class="editor-section-number">3</span><div><span class="editor-eyebrow">Verificare vizuală</span><h2 id="editor-media-title">Imaginea materialului</h2><p>Încarcă fotografia proprie sau folosește ilustrația pregătită de OpenAI.</p></div></div>
              <fieldset class="editor-media"><legend class="sr-only">Fotografia articolului</legend>
                <label for="fisier-imagine">Încarcă o fotografie</label>
                <input type="file" id="fisier-imagine" accept="image/jpeg,image/png,image/webp">
                <label class="editor-consent"><input type="checkbox" id="acord-imagine"> Am dreptul să folosesc și să public această imagine.</label>
                <button type="button" class="candidate-btn secondary" id="incarca-imagine">Încarcă fotografia selectată</button>
                <p class="editor-help" id="stare-imagine" role="status" aria-live="polite">PNG, JPEG sau WebP. Fotografia este redimensionată în browser și salvată în Netlify Blobs, maximum 3 MB. Nu devine publică până nu publici un articol care o folosește.</p>
                <label for="imagine-url">Sau folosește adresa unei imagini publice</label>
                <input type="text" name="imagine_url" id="imagine-url" maxlength="2048" value="<%= articol?.imagine_url || '' %>" placeholder="https://exemplu.ro/fotografie.jpg">
                <figure class="editor-image-preview" id="image-preview" hidden><img id="preview-image" alt="Previzualizare a fotografiei articolului"><figcaption>Imaginea selectată pentru articol</figcaption></figure>
                <div class="editor-field-row">
                  <label for="imagine-alt">Descriere pentru accesibilitate<input id="imagine-alt" name="imagine_alt" maxlength="240" value="<%= articol?.imagine_alt || '' %>" placeholder="Descrie pe scurt ce se vede."></label>
                  <label for="imagine-credit">Autor / sursa imaginii<input id="imagine-credit" name="imagine_credit" maxlength="160" value="<%= articol?.imagine_credit || '' %>"></label>
                </div>
                <label for="imagine-legenda">Legendă sub imagine<input id="imagine-legenda" name="imagine_legenda" maxlength="300" value="<%= articol?.imagine_legenda || '' %>"></label>
                <label class="editor-consent"><input type="checkbox" name="imagine_generata_ai" id="imagine-generata-ai" value="true" <%= articol?.imagine_generata_ai ? 'checked' : '' %>> Imagine generată cu AI (se afișează o etichetă publică).</label>
              </fieldset>
            </section>

            <section class="editor-card editor-form-section" aria-labelledby="editor-check-title">
              <div class="editor-section-heading"><span class="editor-section-number">3</span><div><span class="editor-eyebrow">Control editorial</span><h2 id="editor-check-title">Verifică și asumă materialul</h2><p>Nimic nu se publică automat. Candidatul confirmă forma finală.</p></div></div>
              <label class="editor-consent"><input type="checkbox" name="generat_de_ai" id="generat_de_ai" value="true" <%= articol && articol.generat_de_ai ? 'checked' : '' %>> Text creat cu ajutorul AI (se afișează o etichetă pe site). Verific faptele și îmi asum conținutul înainte de publicare.</label>
              <div class="editor-compliance">
                <strong>Responsabilitate și transparență</strong>
                <p class="editor-help">La publicare sau programare se salvează o copie a finanțatorului, responsabilului editorial, scrutinului, codului mandatarului și datelor contractuale. Ciornele pot fi salvate fără această confirmare.</p>
                <label class="editor-consent"><input type="checkbox" name="confirmare_responsabilitate" <%= confirmareResponsabilitate ? 'checked' : '' %>> Confirm că materialul respectă legea și contractul, că am dreptul să folosesc textele și imaginile și că datele de transparență ale contului sunt corecte.</label>
                <% if (articol?.moderation_status === 'suspendat') { %><p class="eroare">Material suspendat de Super Admin: <%= articol.moderation_reason || 'sesizare în analiză' %>. Îl poți salva doar ca ciornă până la restabilire.</p><% } %>
              </div>
            </section>

            <section class="editor-card editor-publication" aria-labelledby="editor-publish-title">
              <div class="editor-section-heading"><span class="editor-section-number">4</span><div><span class="editor-eyebrow">Ultimul pas</span><h2 id="editor-publish-title">Salvează sau publică</h2><p>Alege ce se întâmplă cu materialul după verificare.</p></div></div>
              <label for="data-programata">Data și ora publicării programate (ora României)</label>
              <input id="data-programata" type="datetime-local" name="data_programata" value="<%= dataProgramata %>" aria-describedby="schedule-help">
              <p id="schedule-help" class="editor-help">Europe/Bucharest, inclusiv schimbarea orei de vară. Data este folosită doar de butonul „Programează”.</p>
              <div class="publication-actions">
                <button type="submit" name="status" value="ciorna" class="candidate-btn secondary">Salveaza ca ciorna</button>
                <button type="submit" name="status" value="programat" class="candidate-btn secondary">Programează</button>
                <button type="submit" name="status" value="publicat" class="candidate-btn primary">Publica pe site</button>
              </div>
            </section>
          </form>
        </div>

        <aside class="editor-card editor-assistant" aria-labelledby="assistant-title">
          <div class="editor-assistant-head"><span class="editor-section-number">2</span><div><span class="editor-eyebrow">Asistent editorial</span><h2 id="assistant-title">Text și imagini cu OpenAI</h2></div></div>
          <p class="editor-assistant-intro">Descrie subiectul și faptele confirmate pentru rubrica <strong><%= articol?.categorie || 'Actualitate' %></strong>. Titlul, rezumatul, tipul, conținutul și ilustrația se încarcă automat în formular.</p>
          <label for="idee-ai">Tema articolului sau a ilustrației</label>
          <textarea id="idee-ai" rows="7" maxlength="4000" placeholder="Ce vrei să explici? Ce informații sunt verificate? Pentru imagine, descrie o scenă ilustrată, fără a o prezenta drept un eveniment real."></textarea>
          <label for="ton-ai">Tonul textului</label>
          <select id="ton-ai"><option value="clar și informativ">Clar și informativ</option><option value="direct și apropiat">Direct și apropiat</option><option value="oficial și formal">Oficial și formal</option></select>
          <label class="editor-consent"><input type="checkbox" id="acord-ai"> Sunt de acord să trimit aceste informații către OpenAI. Nu includ date confidențiale sau date personale nepublice.</label>
          <div class="ai-actions"><button type="button" class="candidate-btn primary" id="btn-genereaza" disabled>Generează material complet</button><button type="button" class="candidate-btn secondary" id="btn-imagine-ai" disabled>Generează doar ilustrația</button></div>
          <p class="editor-status" id="config-ai" role="status">Verific disponibilitatea generării…</p>
          <p class="editor-status" id="stare-ai" role="status" aria-live="polite"></p>
          <button type="button" class="candidate-btn secondary" id="reia-ai" hidden>Verifică din nou rezultatul</button>
          <section class="ai-proposal" id="ai-result" hidden aria-label="Propunere AI"><h3 id="ai-title"></h3><p id="ai-summary"></p><div id="ai-text"></div><img id="ai-image" alt="Previzualizare a ilustrației generate cu AI" hidden><p class="editor-help" id="ai-checks"></p></section>
          <p class="editor-assistant-footnote">Ilustrațiile sunt marcate ca AI. Generarea are costuri API și este disponibilă numai după activarea de către administrator.</p>
        </aside>
      </div>
    </main>
  </div>

  <script src="/editorial-editor.js" defer></script>
</body>
</html>
