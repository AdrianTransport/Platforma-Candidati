<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= user.mesaj_scurt || `${user.nume_candidat} — ${user.functie_candidatura || 'candidat'} pentru ${user.zona || user.judet || 'comunitate'}` %>">
  <title><%= user.nume_candidat %> — <%= user.functie_candidatura || user.zona %></title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/newspaper.css">
</head>
<body class="newspaper-body">
  <div class="newspaper-shell candidate-modern-shell">
    <header class="candidate-modern-header">
      <a href="/site/<%= user.subdomeniu %>" class="candidate-modern-brand">Vocea Candidatului<small><%= electoralMode ? 'PUBLICAȚIE ELECTORALĂ' : 'PUBLICAȚIE CIVICĂ' %></small></a>
      <nav aria-label="Meniul candidatului"><a href="/site/<%= user.subdomeniu %>/despre">Despre mine</a><a href="/site/<%= user.subdomeniu %>/proiecte">Proiecte</a><a href="/site/<%= user.subdomeniu %>/actualitate">Actualitate</a><a href="/site/<%= user.subdomeniu %>/evenimente">Evenimente</a><a href="/site/<%= user.subdomeniu %>/contact">Contact</a></nav>
      <div class="candidate-modern-social public-social-icons"><% [['facebook','f',user.facebook_url],['instagram','◎',user.instagram_url],['tiktok','♪',user.tiktok_url]].forEach(([network,icon,url])=>{ %><% if(url){ %><a class="social-icon <%= network %>" href="/site/<%= user.subdomeniu %>/social/<%= network %>" aria-label="<%= network %>"><%= icon %></a><% } else { %><span class="social-icon <%= network %> is-unconfigured" title="Rețeaua nu este conectată încă" aria-label="<%= network %> neconfigurat"><%= icon %></span><% } %><% }) %><a class="candidate-search-icon" href="#cauta" aria-label="Caută">⌕</a></div>
    </header>
    <% const transparentaPublicatie = publicTransparency(user, null); %>
    <% const principal = candidatura || fluxIdei[0]; const secundare = fluxIdei.filter(a => a.id !== principal?.id); %>
    <section class="civic-candidate-hero" <% if (user.fotografie_coperta_url || principal?.imagine_url) { %>style="--candidate-cover:url('<%= user.fotografie_coperta_url || principal.imagine_url %>')"<% } %>>
      <div class="civic-hero-copy"><span>Pentru o comunitate unită</span><h1><%= user.nume_candidat %></h1><p class="civic-role"><%= user.zona || user.judet || 'Comunitatea locală' %></p><p><%= user.slogan || user.mesaj_scurt || 'Oameni. Fapte. Un viitor mai bun pentru comunitate.' %></p><div><a class="civic-primary-action" href="/site/<%= user.subdomeniu %>/proiecte">Vezi proiectele&nbsp; →</a><a class="civic-secondary-action" href="/site/<%= user.subdomeniu %>/contact">✉ &nbsp;Contact</a></div></div>
      <div class="civic-portrait"><% if (user.fotografie_profil_url) { %><img src="<%= user.fotografie_profil_url %>" alt="<%= user.nume_candidat %>"><% } else { %><span><%= user.nume_candidat.split(' ').map(part => part[0]).slice(0,2).join('') %></span><strong><%= user.nume_candidat %></strong><small><%= user.functie_candidatura || 'Vocea comunității' %></small><% } %></div>
    </section>
    <nav class="civic-feature-grid" aria-label="Explorează publicația"><a href="/site/<%= user.subdomeniu %>/program"><span>◎</span><strong>Priorități</strong><small>Program și obiective pentru comunitate</small><em>Află mai multe →</em></a><a href="/site/<%= user.subdomeniu %>/proiecte"><span>⚙</span><strong>Proiecte</strong><small>Idei concrete și stadiul lor</small><em>Vezi proiectele →</em></a><a href="/site/<%= user.subdomeniu %>/actualitate"><span>▤</span><strong>Actualitate</strong><small>Noutăți și poziții publice</small><em>Citește noutățile →</em></a><a href="/site/<%= user.subdomeniu %>/evenimente"><span>□</span><strong>Evenimente</strong><small>Întâlniri și acțiuni locale</small><em>Vezi evenimentele →</em></a></nav>
    <section class="candidate-modern-community">
      <a href="/site/<%= user.subdomeniu %>/despre" class="candidate-modern-quote"><blockquote>„<%= user.mesaj_scurt || user.slogan || 'Comunitatea are oameni frumoși și un potențial real. Împreună putem construi mai mult.' %>”</blockquote><strong><%= user.nume_candidat %></strong></a>
      <aside><h2>Urmărește activitatea mea</h2><% if(user.facebook_url){ %><a href="/site/<%= user.subdomeniu %>/social/facebook"><b>f</b><span><strong>Facebook</strong><small>Noutăți și dialog cu comunitatea</small></span></a><% } %><% if(user.instagram_url){ %><a href="/site/<%= user.subdomeniu %>/social/instagram"><b>◎</b><span><strong>Instagram</strong><small>Oameni și locurile comunității</small></span></a><% } %><% if(user.tiktok_url){ %><a href="/site/<%= user.subdomeniu %>/social/tiktok"><b>♪</b><span><strong>TikTok</strong><small>Momente din viața comunității</small></span></a><% } %><% if(!user.facebook_url&&!user.instagram_url&&!user.tiktok_url){ %><p>Rețelele sociale vor apărea aici după conectare.</p><% } %></aside>
    </section>
    <section class="political-ad-banner <%= electoralMode ? '' : 'civic-disclosure' %>" aria-label="Informații despre responsabilitatea editorială"><strong><%= electoralMode ? 'Material electoral · publicitate politică' : 'Publicație civică independentă' %></strong><span><%= electoralMode ? `Finanțat de ${transparentaPublicatie.finantat_de} · ` : '' %>publicat și asumat de <%= transparentaPublicatie.responsabil_editorial %></span><a href="/site/<%= user.subdomeniu %>/transparenta">Vezi transparența completă</a></section>
    <form id="cauta" method="GET" action="/site/<%= user.subdomeniu %>" class="newspaper-search" role="search">
      <label>Caută în articole<input type="search" name="cauta" maxlength="120" value="<%= cautaText %>" placeholder="Titlu sau conținut"></label>
      <label>Categorie<select name="categorie"><option value="">Toate categoriile</option>
        <% if (categorieSelectata && !categoriiToate.includes(categorieSelectata)) { %><option selected value="<%= categorieSelectata %>"><%= categorieSelectata %></option><% } %>
        <% categoriiToate.forEach(c => { %><option value="<%= c %>" <%= c === categorieSelectata ? 'selected' : '' %>><%= c %></option><% }) %>
      </select></label>
      <button type="submit" class="secondary">Caută</button>
      <% if (cautaText || categorieSelectata) { %><a href="/site/<%= user.subdomeniu %>">Resetează filtrele</a><% } %>
    </form>
    <% if (cautaText || categorieSelectata) { %><p class="search-summary" role="status"><%= rezultatTotal %> rezultate<% if (cautaText) { %> pentru „<%= cautaText %>”<% } %></p><% } %>

    <main class="edition-main">
    <div class="edition-label"><strong><%= categorieSelectata || 'Din publicație' %></strong><span>Idei, proiecte și mesaje asumate de <%= user.nume_candidat %></span></div>
    <% if (principal) { %>
      <section class="front-page" aria-label="În prim-plan">
        <article class="front-main">
          <%- include('partials/news-image', { item: principal, user, eager: true }) %>
          <span class="article-label"><%= principal.categorie %> · În prim-plan</span>
          <h1><a href="/site/<%= user.subdomeniu %>/articol/<%= principal.id %>"><%= principal.titlu %></a></h1>
          <p><%= principal.rezumat || `${principal.continut.slice(0, 300)}${principal.continut.length > 300 ? '…' : ''}` %></p>
          <div class="story-meta"><time><%= displayDate(publicationDate(principal)) %></time><span><%= principal.vizualizari || 0 %> afișări</span></div>
          <a class="read-more" href="/site/<%= user.subdomeniu %>/articol/<%= principal.id %>">Citește articolul</a>
        </article>
        <aside class="front-sidebar" aria-label="Alte materiale">
          <% secundare.slice(0, 2).forEach(a => { %><article>
            <%- include('partials/news-image', { item: a, user }) %>
            <span class="article-label"><%= a.categorie %></span>
            <h2><a href="/site/<%= user.subdomeniu %>/articol/<%= a.id %>"><%= a.titlu %></a></h2>
            <p><%= a.rezumat || `${a.continut.slice(0, 120)}${a.continut.length > 120 ? '…' : ''}` %></p>
            <div class="story-meta"><time><%= displayDate(publicationDate(a)) %></time></div>
          </article><% }) %>
          <% if (!secundare.length) { %><article><span class="article-label">Autorul publicației</span><h2><%= user.nume_candidat %></h2><p><%= user.mesaj_scurt || user.descriere || (electoralMode ? 'Aceasta este publicația electorală a candidatului.' : 'Aceasta este publicația civică a candidatului.') %></p><a class="read-more" href="/site/<%= user.subdomeniu %>/despre">Despre candidat</a></article><% } %>
        </aside>
      </section>
    <% } else if (cautaText || categorieSelectata) { %><div class="newspaper-empty"><h1>Niciun articol găsit</h1><p>Încearcă alt termen sau elimină filtrul de categorie.</p></div>
    <% } else { %><div class="newspaper-empty"><h1><%= user.slogan || 'Publicația este pregătită.' %></h1><p>Primele articole vor apărea în curând.</p></div><% } %>

    <% if (secundare.length > 2) { %>
      <section aria-labelledby="latest-title"><div class="section-heading"><h2 id="latest-title">Mai multe din publicație</h2><a href="#rubrici">Explorează rubricile</a></div>
      <div class="photo-grid"><% secundare.slice(2, 8).forEach(a => { %><article class="photo-card">
        <%- include('partials/news-image', { item: a, user }) %>
        <span class="article-label"><%= a.categorie %></span><h3><a href="/site/<%= user.subdomeniu %>/articol/<%= a.id %>"><%= a.titlu %></a></h3>
        <p><%= a.rezumat || `${a.continut.slice(0, 150)}${a.continut.length > 150 ? '…' : ''}` %></p><div class="story-meta"><time><%= displayDate(publicationDate(a)) %></time><span><%= a.vizualizari || 0 %> afișări</span></div>
      </article><% }) %></div></section>
    <% } %>

    <div class="editorial-columns" id="rubrici"><div class="editorial-categories">
    <% Object.entries(categorii).forEach(([categorie, lista]) => { const ancora = categorie.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-'); %>
      <section class="category-section" id="rubrica-<%= ancora %>"><div class="category-title"><h2><%= categorie %></h2><span><%= lista.length %> materiale</span></div><div class="category-list"><% lista.forEach(a => { %><a href="/site/<%= user.subdomeniu %>/articol/<%= a.id %>">
        <% if (a.imagine_url) { %><img src="<%= a.imagine_url %>" alt="<%= a.imagine_alt || '' %>" loading="lazy" decoding="async" width="128" height="88" referrerpolicy="no-referrer"><% } else { %><span class="no-thumbnail"><%= categorie %></span><% } %>
        <div><strong><%= a.titlu %></strong><time><%= displayDate(publicationDate(a)) %> · <%= a.vizualizari || 0 %> afișări<% if (a.imagine_generata_ai) { %> · Ilustrație AI<% } %></time></div>
      </a><% }) %></div></section>
    <% }) %>
    </div><% if (principal) { const populare = [principal, ...secundare].sort((a,b) => (b.vizualizari || 0) - (a.vizualizari || 0)).slice(0,5); %>
      <aside class="edition-aside"><h2>Cele mai accesate</h2><ol class="most-read"><% populare.forEach(a => { %><li><a href="/site/<%= user.subdomeniu %>/articol/<%= a.id %>"><%= a.titlu %><small><%= a.vizualizari || 0 %> afișări</small></a></li><% }) %></ol><p>Contorul măsoară afișările paginii, nu cititori unici sau lectura integrală.</p></aside>
    <% } %></div>
    </main>
    <% if (sondaj) { %><section class="candidate-profile candidate-poll-section" id="sondaj"><%- include('partials/poll', { poll: sondaj }) %></section><% } %>

    <section class="candidate-profile" id="despre"><div class="candidate-monogram"><%= user.nume_candidat.split(' ').map(p => p[0]).slice(0,2).join('') %></div><div><span class="article-label">Despre candidat</span><h2><%= user.nume_candidat %></h2><p><%= user.descriere || user.mesaj_scurt || 'Prezentarea candidatului va fi publicată aici.' %></p><strong><%= [user.functie_candidatura, user.partid, user.zona].filter(Boolean).join(' · ') %></strong><p><a class="read-more" href="/site/<%= user.subdomeniu %>/despre">Citește prezentarea completă</a></p></div></section>

    <% if (user.module?.social && [user.facebook_url, user.instagram_url, user.tiktok_url, user.youtube_url].some(Boolean)) { %><section class="social-strip"><span>Urmărește campania</span><div><% ['facebook','instagram','tiktok','youtube'].forEach(platforma => { if (user[`${platforma}_url`]) { %><a href="/site/<%= user.subdomeniu %>/social/<%= platforma %>" target="_blank" rel="noopener"><%= platforma %></a><% } }) %></div></section><% } %>

    <footer class="newspaper-footer"><div><strong><%= user.nume_candidat %></strong><span><%= user.slogan || 'Pentru comunitate.' %></span></div><p><%= electoralMode ? `Material electoral finanțat de ${transparentaPublicatie.finantat_de} și ` : 'Publicație civică ' %>asumată de <%= transparentaPublicatie.responsabil_editorial %>. Statisticile numără afișări, fără profiluri politice ale cititorilor. Comentariile sunt moderate înainte de afișare.</p><nav class="footer-links" aria-label="Informații legale"><a href="/site/<%= user.subdomeniu %>/transparenta">Transparență</a><a href="/legal/termeni">Termeni</a><a href="/legal/confidentialitate">Confidențialitate</a><a href="/legal/raportare">Raportare</a><a href="/">Parte din Vocea Locală Lenauheim</a></nav></footer>
  </div>
<script>document.querySelectorAll('.photo-card,.front-sidebar article').forEach(card=>{const link=card.querySelector('a[href]');if(!link)return;card.tabIndex=0;card.setAttribute('role','link');card.addEventListener('click',event=>{if(!event.target.closest('a,button'))location.href=link.href;});card.addEventListener('keydown',event=>{if(event.key==='Enter')location.href=link.href;});});</script>
</body>
</html>
