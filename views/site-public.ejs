<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= user.mesaj_scurt || `${user.nume_candidat} — ${user.functie_candidatura || 'candidat'} pentru ${user.zona || user.judet || 'comunitate'}` %>">
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= user.nume_candidat %> — <%= user.functie_candidatura || user.zona %>">
  <meta property="og:description" content="<%= user.mesaj_scurt || `${user.nume_candidat} — ${user.functie_candidatura || 'candidat'} pentru ${user.zona || user.judet || 'comunitate'}` %>">
  <meta property="og:url" content="<%= pageUrl %>">
  <% if (candidatura?.imagine_url) { %><meta property="og:image" content="<%= new URL(candidatura.imagine_url, pageUrl).toString() %>"><% } %>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="alternate" type="application/rss+xml" title="<%= user.nume_candidat %>" href="/site/<%= user.subdomeniu %>/rss.xml">
  <title><%= user.nume_candidat %> — <%= user.functie_candidatura || user.zona %></title>
  <link rel="stylesheet" href="<%= stylesheetUrl %>">
  <link rel="stylesheet" href="/newspaper.css">
  <link rel="stylesheet" href="/candidate-site.css?v=20260911-cutout1">
</head>
<body class="newspaper-body candidate-design">
  <div class="candidate-site-shell">
    <%- include('partials/candidate-header', { user, activeSection }) %>
    <% const transparentaPublicatie = publicTransparency(user, null); %>
    <% const principal = candidatura || fluxIdei[0]; const secundare = fluxIdei.filter(a => a.id !== principal?.id); %>
    <main id="candidate-main">
      <% const profileBase = `/site/${user.subdomeniu}`;
         const transparentPortrait = isTransparentPortrait(user.fotografie_profil_url);
         const profileInitials = user.nume_candidat.split(' ').map(p => p[0]).slice(0,2).join('');
         const profileTopics = [
           ['program','Priorități','Programul și obiectivele publicate de candidat.'],
           ['proiecte','Proiecte','Proiectele prezentate și evoluția lor.'],
           ['actualitate','Actualitate','Articolele și pozițiile publice ale candidatului.'],
           ['evenimente','Evenimente','Întâlnirile și activitățile anunțate.'],
           ['despre','Despre mine','Prezentarea și informațiile din profil.'],
           ['contact','Contact','Datele publice de contact ale candidatului.']
         ];
      %>
      <section class="candidate-hero">
        <div class="candidate-container candidate-hero-grid">
          <div class="candidate-hero-copy">
            <h1 class="<%= user.nume_candidat.length > 20 ? 'candidate-name-long' : '' %>"><%= user.nume_candidat %></h1>
            <p class="candidate-hero-message"><%= user.slogan || user.mesaj_scurt || [user.functie_candidatura, user.zona, user.judet].filter(Boolean).join(' · ') %></p>
            <div class="candidate-actions"><a class="candidate-button candidate-button-white" href="<%= profileBase %>/proiecte">Vezi proiectele</a><a class="candidate-button candidate-button-outline" href="<%= profileBase %>/despre">Despre mine</a></div>
          </div>
          <div class="candidate-hero-visual"><div class="candidate-portrait-frame<%= user.fotografie_profil_url ? ' candidate-portrait-frame-photo' : '' %><%= transparentPortrait ? ' candidate-portrait-cutout' : '' %>">
            <% if (user.fotografie_profil_url) { %><img src="<%= publicImageUrl(user.fotografie_profil_url) %>" alt="<%= user.nume_candidat %>" width="<%= transparentPortrait ? 1142 : 640 %>" height="<%= transparentPortrait ? 1377 : 640 %>" fetchpriority="high" decoding="async"><% } else { %><span class="candidate-portrait-initials" aria-label="<%= user.nume_candidat %>"><%= profileInitials %></span><% } %>
          </div></div>
        </div>
      </section>
      <section class="candidate-section candidate-community-overview">
        <div class="candidate-container">
          <div class="candidate-section-heading"><span class="candidate-eyebrow"><%= electoralMode ? 'PUBLICAȚIE ELECTORALĂ' : 'PUBLICAȚIE CIVICĂ' %></span><h2>Activitatea candidatului, într-un singur loc.</h2><p>Prezentare, priorități, proiecte și informații publicate de <%= user.nume_candidat %>.</p></div>
          <div class="candidate-facts-strip" aria-label="Profil pe scurt">
            <% [['Funcție', user.functie_candidatura || 'Candidat', 1], ['Comunitate', user.zona || user.judet || 'Nespecificată', 2], ['Formațiune / statut', user.partid || 'Nespecificat', 5], ['Publicație', electoralMode ? 'Electorală' : 'Civică', 6]].forEach(([label,value,icon]) => { %>
              <div><img src="/candidate-assets/topic-<%= icon %>.png" alt="" width="180" height="180" loading="lazy" decoding="async"><strong><%= value %></strong><span><%= label %></span></div>
            <% }) %>
          </div>
          <div class="candidate-actions candidate-actions-center"><a class="candidate-button" href="<%= profileBase %>/program">Vezi prioritățile</a><a class="candidate-button candidate-button-secondary" href="<%= profileBase %>/contact">Date de contact</a></div>
        </div>
      </section>
      <section class="candidate-section candidate-section-muted" id="despre">
        <div class="candidate-container candidate-intro-split">
          <div class="candidate-intro-copy"><span class="candidate-eyebrow">Despre candidat</span><h2><%= user.nume_candidat %></h2><p class="candidate-about-summary"><%= user.descriere || user.mesaj_scurt || 'Prezentarea candidatului va fi publicată aici.' %></p>
            <nav class="candidate-check-links" aria-label="Rubricile publicației"><% profileTopics.forEach(([slug,label]) => { %><a href="<%= profileBase %>/<%= slug %>"><span aria-hidden="true">✓</span><%= label %></a><% }) %></nav>
            <%- include('partials/candidate-party', { user }) %>
            <div class="candidate-actions"><a class="candidate-button" href="<%= profileBase %>/despre">Citește prezentarea</a><a class="candidate-button candidate-button-secondary" href="<%= profileBase %>/contact">Contact</a></div>
          </div>
          <div class="candidate-intro-visual">
            <% if (user.fotografie_profil_url || user.fotografie_coperta_url) { %><img class="candidate-intro-photo<%= transparentPortrait ? ' candidate-intro-cutout' : '' %>" src="<%= publicImageUrl(user.fotografie_profil_url || user.fotografie_coperta_url) %>" alt="<%= user.nume_candidat %>" width="<%= transparentPortrait ? 1142 : 620 %>" height="<%= transparentPortrait ? 1377 : 720 %>" loading="lazy" decoding="async"><% } else { %><span class="candidate-about-monogram"><%= profileInitials %></span><% } %>
            <div class="candidate-quote"><% if (user.mesaj_scurt || user.slogan) { %><p>„<%= user.mesaj_scurt || user.slogan %>”</p><% } %><div class="candidate-quote-author"><% if (user.fotografie_profil_url) { %><img src="<%= publicImageUrl(user.fotografie_profil_url) %>" alt="" width="64" height="64" loading="lazy"><% } %><div><strong><%= user.nume_candidat %></strong><span><%= [user.functie_candidatura,user.zona].filter(Boolean).join(' · ') %></span></div></div></div>
          </div>
        </div>
      </section>
      <% if (user.fotografie_coperta_url) { %>
      <section class="candidate-section">
        <div class="candidate-container candidate-locality-split">
          <div class="candidate-locality-visual"><img src="<%= user.fotografie_coperta_url %>" alt="Imagine de copertă — <%= user.zona || user.nume_candidat %>" width="640" height="680" loading="lazy" decoding="async"><div class="candidate-locality-facts"><div><strong><%= user.zona || 'Comunitate' %></strong><span>Localitate</span></div><% if(user.judet){ %><div><strong><%= user.judet %></strong><span>Județ</span></div><% } %></div></div>
          <div><span class="candidate-eyebrow">Comunitatea</span><h2><%= [user.zona,user.judet].filter(Boolean).join(', ') %></h2><p>Programul, proiectele și articolele publicate de <%= user.nume_candidat %> pentru această comunitate.</p><div class="candidate-actions"><a class="candidate-button" href="<%= profileBase %>/proiecte">Vezi proiectele</a><a class="candidate-button candidate-button-secondary" href="<%= profileBase %>/actualitate">Actualitate</a></div></div>
        </div>
      </section>
      <% } %>
      <section class="candidate-contact-feature"><div class="candidate-container candidate-contact-feature-grid"><div><span class="candidate-eyebrow">Contact</span><h2>Datele de contact ale candidatului.</h2><p><%= user.nume_candidat %></p><a class="candidate-button candidate-button-white" href="<%= profileBase %>/contact">Deschide pagina de contact</a></div><div class="candidate-feature-visual"><% if(user.fotografie_coperta_url || user.fotografie_profil_url){ %><img src="<%= publicImageUrl(user.fotografie_coperta_url || user.fotografie_profil_url) %>" alt="" width="620" height="460" loading="lazy" decoding="async"><% } %><div class="candidate-feature-card"><strong><%= user.zona || user.judet || user.nume_candidat %></strong><span><%= user.functie_candidatura || 'Candidat' %></span></div></div></div></section>
      <section class="candidate-section candidate-explore" id="prioritati"><div class="candidate-container"><div class="candidate-section-heading"><span class="candidate-eyebrow">Explorează publicația</span><h2>Priorități, proiecte și activitate publică</h2><p>Alege rubrica pe care vrei să o urmărești.</p></div>
        <nav class="candidate-topic-grid" aria-label="Explorează publicația">
          <% profileTopics.forEach(([slug,title,description],i)=>{ %>
            <a href="<%= profileBase %>/<%= slug %>"><img src="/candidate-assets/topic-<%= i+1 %>.png" alt="" width="110" height="110" loading="lazy" decoding="async"><h3><%= title %></h3><p><%= description %></p><span class="candidate-topic-link">Vezi rubrica</span></a>
          <% }) %>
        </nav>
      </div></section>
      <section class="candidate-container candidate-publications candidate-section" id="publicatii"><div class="candidate-section-heading"><span class="candidate-eyebrow">Din publicație</span><h2>Articole și noutăți</h2></div>
    <form id="cauta" method="GET" action="/site/<%= user.subdomeniu %>" class="newspaper-search" role="search">
      <label>Caută în articole<input type="search" name="cauta" maxlength="120" value="<%= cautaText %>" placeholder="Titlu sau conținut"></label>
      <label>Categorie<select name="categorie"><option value="">Toate categoriile</option>
        <% if (categorieSelectata && !categoriiToate.includes(categorieSelectata)) { %><option selected value="<%= categorieSelectata %>"><%= categorieSelectata %></option><% } %>
        <% categoriiToate.forEach(c => { %><option value="<%= c %>" <%= c === categorieSelectata ? 'selected' : '' %>><%= c %></option><% }) %>
      </select></label>
      <button type="submit" class="secondary">Caută</button>
      <% if (cautaText || categorieSelectata) { %><a href="/site/<%= user.subdomeniu %>">Resetează filtrele</a><% } %>
    </form>
    <% if (cautaText || categorieSelectata) { %><p class="search-summary" role="status"><%= rezultatTotal %> rezultate<% if (cautaText) { %> pentru „<%= cautaText %>”<% } %></p><% } %>

    <div class="edition-main">
    <div class="edition-label"><strong><%= categorieSelectata || 'Din publicație' %></strong><span>Idei, proiecte și mesaje asumate de <%= user.nume_candidat %></span></div>
    <% if (principal) { %>
      <section class="front-page" aria-label="În prim-plan">
        <article class="front-main">
          <%- include('partials/news-image', { item: principal, user, eager: true }) %>
          <span class="article-label"><%= principal.categorie %> · În prim-plan</span>
          <h2><a href="/site/<%= user.subdomeniu %>/articol/<%= principal.id %>"><%= principal.titlu %></a></h2>
          <p><%= principal.rezumat || `${principal.continut.slice(0, 300)}${principal.continut.length > 300 ? '…' : ''}` %></p>
          <div class="story-meta"><time><%= displayDate(publicationDate(principal)) %></time><span><%= principal.vizualizari || 0 %> afișări</span></div>
          <a class="read-more" href="/site/<%= user.subdomeniu %>/articol/<%= principal.id %>">Citește articolul</a>
        </article>
        <aside class="front-sidebar" aria-label="Alte materiale">
          <% secundare.slice(0, 2).forEach(a => { %><article>
            <%- include('partials/news-image', { item: a, user }) %>
            <span class="article-label"><%= a.categorie %></span>
            <h2><a href="/site/<%= user.subdomeniu %>/articol/<%= a.id %>"><%= a.titlu %></a></h2>
            <p><%= a.rezumat || `${a.continut.slice(0, 120)}${a.continut.length > 120 ? '…' : ''}` %></p>
            <div class="story-meta"><time><%= displayDate(publicationDate(a)) %></time></div>
          </article><% }) %>
          <% if (!secundare.length) { %><article><span class="article-label">Autorul publicației</span><h2><%= user.nume_candidat %></h2><p><%= user.mesaj_scurt || user.descriere || (electoralMode ? 'Aceasta este publicația electorală a candidatului.' : 'Aceasta este publicația civică a candidatului.') %></p><a class="read-more" href="/site/<%= user.subdomeniu %>/despre">Despre candidat</a></article><% } %>
        </aside>
      </section>
    <% } else if (cautaText || categorieSelectata) { %><div class="newspaper-empty"><h2>Niciun articol găsit</h2><p>Încearcă alt termen sau elimină filtrul de categorie.</p></div>
    <% } else { %><div class="newspaper-empty"><h2>Primele articole, în curând</h2><p>Primele articole vor apărea în curând.</p></div><% } %>

    <% if (secundare.length > 2) { %>
      <section aria-labelledby="latest-title"><div class="section-heading"><h2 id="latest-title">Mai multe din publicație</h2><a href="#rubrici">Explorează rubricile</a></div>
      <div class="photo-grid"><% secundare.slice(2, 8).forEach(a => { %><article class="photo-card">
        <%- include('partials/news-image', { item: a, user }) %>
        <span class="article-label"><%= a.categorie %></span><h3><a href="/site/<%= user.subdomeniu %>/articol/<%= a.id %>"><%= a.titlu %></a></h3>
        <p><%= a.rezumat || `${a.continut.slice(0, 150)}${a.continut.length > 150 ? '…' : ''}` %></p><div class="story-meta"><time><%= displayDate(publicationDate(a)) %></time><span><%= a.vizualizari || 0 %> afișări</span></div>
      </article><% }) %></div></section>
    <% } %>

    <div class="editorial-columns" id="rubrici"><div class="editorial-categories">
    <% Object.entries(categorii).forEach(([categorie, lista]) => { const ancora = categorie.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-'); %>
      <section class="category-section" id="rubrica-<%= ancora %>"><div class="category-title"><h2><%= categorie %></h2><span><%= lista.length %> materiale</span></div><div class="category-list"><% lista.forEach(a => { %><a href="/site/<%= user.subdomeniu %>/articol/<%= a.id %>">
        <% if (a.imagine_url) { %><img src="<%= a.imagine_url %>" alt="<%= a.imagine_alt || '' %>" loading="lazy" decoding="async" width="128" height="88" referrerpolicy="no-referrer"><% } else { %><span class="no-thumbnail"><%= categorie %></span><% } %>
        <div><strong><%= a.titlu %></strong><time><%= displayDate(publicationDate(a)) %> · <%= a.vizualizari || 0 %> afișări<% if (a.imagine_generata_ai) { %> · Ilustrație AI<% } %></time></div>
      </a><% }) %></div></section>
    <% }) %>
    </div><% if (principal) { const populare = [principal, ...secundare].sort((a,b) => (b.vizualizari || 0) - (a.vizualizari || 0)).slice(0,5); %>
      <aside class="edition-aside"><h2>Cele mai accesate</h2><ol class="most-read"><% populare.forEach(a => { %><li><a href="/site/<%= user.subdomeniu %>/articol/<%= a.id %>"><%= a.titlu %><small><%= a.vizualizari || 0 %> afișări</small></a></li><% }) %></ol><p>Contorul măsoară afișările paginii, nu cititori unici sau lectura integrală.</p></aside>
    <% } %></div>
    </div>

      </section>
      <% if (sondaj) { %><section class="candidate-container candidate-poll-section" id="sondaj"><%- include('partials/poll', { poll: sondaj }) %></section><% } %>
      <section class="candidate-contact-band"><div class="candidate-container"><div><span class="candidate-eyebrow">Contact</span><h2>În legătură cu comunitatea.</h2></div><a class="candidate-button" href="/site/<%= user.subdomeniu %>/contact">Contactează candidatul</a></div></section>
    </main>
    <section class="political-ad-banner <%= electoralMode ? '' : 'civic-disclosure' %>" aria-label="Informații despre responsabilitatea editorială"><strong><%= electoralMode ? 'Material electoral · publicitate politică' : 'Publicație civică independentă' %></strong><span><%= electoralMode ? `Finanțat de ${transparentaPublicatie.finantat_de} · ` : '' %>publicat și asumat de <%= transparentaPublicatie.responsabil_editorial %></span><a href="/site/<%= user.subdomeniu %>/transparenta">Vezi transparența completă</a></section>
    <%- include('partials/candidate-footer', { user }) %>
  </div>
  <%- include('partials/cristianweb-credit') %>
</body>
</html>
