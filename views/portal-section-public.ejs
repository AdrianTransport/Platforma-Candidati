<!DOCTYPE html><html lang="ro"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= section.titlu %> — Vocea Locală Lenauheim</title><link rel="stylesheet" href="/style.css"></head>
<body class="public-body portal-public-body"><header class="portal-news-header"><a class="platform-brand local-brand" href="/"><span>Vocea Locală</span><strong>Lenauheim</strong></a><nav><a href="/sectiune/stiri">Știri</a><a href="/sectiune/administratie">Administrație</a><a href="/sectiune/comunitate">Comunitate</a><a href="/sectiune/educatie">Educație</a><a href="/sectiune/economie">Economie</a><a href="/sectiune/evenimente">Evenimente</a><a href="/candidati">Candidați</a><a class="btn secondary" href="/login">Autentificare</a></nav></header>
<main><section class="portal-section-hero"><a href="/">← Prima pagină</a><span class="eyebrow">Vocea Locală Lenauheim</span><h1><%= section.titlu %></h1><p><%= section.descriere %></p></section><section class="portal-news-section"><% if (!posts.length) { %><div class="empty-public">Nu există încă materiale publicate în această secțiune.</div><% } else { %><div class="portal-card-grid"><% posts.forEach(post => { %><a class="portal-news-card portal-clickable-card" href="/actualitate/<%= post.slug %>"><span class="portal-card-image"><% if (post.imagine_url) { %><img src="<%= post.imagine_url %>" alt="<%= post.imagine_alt || '' %>" loading="lazy" decoding="async"><% } else { %><b><%= post.categorie %></b><% } %></span><span class="portal-card-copy"><small class="portal-section-label"><%= post.categorie %></small><strong><%= post.titlu %></strong><span><%= post.rezumat %></span><small><%= displayDate(portalPublicationDate(post)) %> · <%= post.vizualizari || 0 %> citiri · 👍 <%= post.reactii?.like || 0 %></small></span></a><% }) %></div><% } %></section></main>
<footer class="marketing-footer"><strong>Vocea Locală Lenauheim</strong><span>Bulgăruș · Lenauheim · Grabaț</span><nav class="legal-links"><a href="/legal/termeni">Termeni</a><a href="/legal/confidentialitate">Confidențialitate</a><a href="/legal/cookies">Cookies</a></nav></footer><%- include('partials/cristianweb-credit') %></body></html>
