<% const footerTransparency = publicTransparency(user, null); %>
<footer class="candidate-footer"><div class="candidate-container">
  <div class="candidate-footer-grid">
    <div><a class="candidate-brand" href="/site/<%= user.subdomeniu %>"><span class="candidate-brand-mark" aria-hidden="true"><%= user.nume_candidat.split(' ').map(p=>p[0]).slice(0,2).join('') %></span><span><strong><%= user.nume_candidat %></strong><small>Vocea Candidatului</small></span></a><p><%= [user.functie_candidatura,user.zona,user.judet].filter(Boolean).join(' · ') %></p><% if(user.email_contact){ %><a class="candidate-footer-contact" href="mailto:<%= user.email_contact %>"><%= user.email_contact %></a><% } %><% if(user.telefon_contact){ %><a class="candidate-footer-contact" href="tel:<%= user.telefon_contact.replace(/[^+\d]/g,'') %>"><%= user.telefon_contact %></a><% } %></div>
    <nav aria-label="Paginile candidatului"><strong>Explorează</strong><a href="/site/<%= user.subdomeniu %>/despre">Despre mine</a><a href="/site/<%= user.subdomeniu %>/program">Priorități</a><a href="/site/<%= user.subdomeniu %>/proiecte">Proiecte</a><a href="/site/<%= user.subdomeniu %>/actualitate">Actualitate</a><a href="/site/<%= user.subdomeniu %>/evenimente">Evenimente</a><a href="/site/<%= user.subdomeniu %>/contact">Contact</a></nav>
    <nav aria-label="Informații legale"><strong>Informații</strong><a href="/site/<%= user.subdomeniu %>/transparenta">Transparență</a><a href="/legal/termeni">Termeni</a><a href="/legal/confidentialitate">Confidențialitate</a><a href="/legal/cookies">Cookies</a><a href="/legal/raportare">Raportare</a></nav>
    <div><strong>Urmărește activitatea</strong><div class="candidate-footer-social"><% ['facebook','instagram','tiktok','youtube'].forEach(network=>{ if(user.module?.social && user[`${network}_url`]){ %><a href="/site/<%= user.subdomeniu %>/social/<%= network %>" target="_blank" rel="noopener noreferrer"><%= network.charAt(0).toUpperCase()+network.slice(1) %></a><% } }); %></div><a class="candidate-button" href="/site/<%= user.subdomeniu %>/contact">Date de contact</a></div>
  </div>
  <div class="candidate-footer-bottom"><p><%= electoralMode ? `Material electoral finanțat de ${footerTransparency.finantat_de}. ` : 'Publicație civică independentă. ' %>Conținut publicat și asumat de <%= footerTransparency.responsabil_editorial %>. Statisticile numără afișări, fără profiluri politice ale cititorilor. Comentariile sunt moderate înainte de afișare.</p><a href="/">Vocea Locală Lenauheim</a></div>
</div></footer>
