<section class="article-engagement" id="reactii" aria-label="Reacții și distribuire">
  <div class="reaction-panel"><div><span class="eyebrow">Părerea comunității</span><strong>Ți-a fost util acest material?</strong></div><form method="POST" action="<%= reactionAction %>" class="reaction-actions"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button name="reactie" value="like" type="submit" aria-label="Îmi place">👍 <span><%= item.reactii?.like || 0 %></span></button><button name="reactie" value="dislike" type="submit" aria-label="Nu îmi place">👎 <span><%= item.reactii?.dislike || 0 %></span></button></form></div>
  <div class="share-panel"><strong>Distribuie</strong><div><a target="_blank" rel="noopener noreferrer" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(publicUrl) %>">Facebook</a><a target="_blank" rel="noopener noreferrer" href="https://wa.me/?text=<%= encodeURIComponent(`${item.titlu} ${publicUrl}`) %>">WhatsApp</a><button type="button" class="native-share" data-share-title="<%= item.titlu %>" data-share-url="<%= publicUrl %>">Distribuie</button><button type="button" class="copy-share" data-share-url="<%= publicUrl %>">Copiază linkul</button></div></div>
</section>
<script src="/share-actions.js" defer></script>
