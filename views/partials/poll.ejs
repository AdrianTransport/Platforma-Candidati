<div class="public-poll"><span class="eyebrow">Sondaj rapid</span><h2><%= poll.question %></h2><% const total = poll.options.reduce((sum, option) => sum + option.votes, 0); %><form method="POST" action="/sondaje/<%= poll.id %>/vot"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><div class="poll-options"><% poll.options.forEach(option => { const percent = total ? Math.round(option.votes * 100 / total) : 0; %><label><input type="radio" name="optiune" value="<%= option.id %>" required><span><strong><%= option.text %></strong><% if (poll.show_results) { %><small><%= percent %>% · <%= option.votes %> voturi</small><i style="width:<%= percent %>%"></i><% } %></span></label><% }) %></div><button type="submit">Votează</button></form><p class="poll-disclaimer">Sondaj informal, fără valoare statistică reprezentativă. Nu solicită nume sau email și limitează voturile repetate în același browser.</p></div>
