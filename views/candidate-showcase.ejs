<%- include('partials/vl-top', { seo, section: 'candidati' }) %>
<div class="page-head">
<div><span class="eyebrow">VITRINA PUBLICĂ</span><h1>Toți candidații activi</h1><p class="muted page-head__lead"><%= total %> candidați găsiți. Fiecare candidat își administrează și își asumă propria publicație.</p></div>
</div>
<form method="GET" class="filters-form glass">
<label class="fld">Caută<input type="search" name="cauta" value="<%= cauta %>" placeholder="Nume, localitate sau partid"></label>
<label class="fld">Județ<select name="judet"><option value="">Toate județele</option><% judete.forEach(value => { %><option <%= value === judet ? 'selected' : '' %>><%= value %></option><% }) %></select></label>
<label class="fld">Funcție<input name="functie" value="<%= functie %>" placeholder="Primar, consilier..."></label>
<div class="filters-form__actions"><button class="btn btn--dark" type="submit">Filtrează</button><a class="btn btn--light" href="/candidati">Resetează</a></div>
</form>
<% if (!candidati.length) { %><p class="empty glass">Nu există candidați pentru filtrele selectate.</p>
<% } else { %>
<div class="people"><% candidati.forEach(c => { %><a class="person glass" href="/site/<%= c.subdomeniu %>"><span class="person__role"><%= c.functie_candidatura || 'Candidat' %></span><b><%= c.nume_candidat %></b><span class="person__place"><%= [c.partid, c.zona, c.judet].filter(Boolean).join(' · ') %></span><span class="person__more">Deschide publicația →</span></a><% }) %></div>
<% } %>
<% if (pages > 1) { %><nav class="pager" aria-label="Pagini"><% for (let i = 1; i <= pages; i++) { %><% if (i === page) { %><span aria-current="page"><%= i %></span><% } else { %><a href="?cauta=<%= encodeURIComponent(cauta) %>&judet=<%= encodeURIComponent(judet) %>&functie=<%= encodeURIComponent(functie) %>&pagina=<%= i %>"><%= i %></a><% } %><% } %></nav><% } %>
<%- include('partials/vl-bottom', { section: 'candidati' }) %>
