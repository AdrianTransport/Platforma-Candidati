<%- include('partials/vl-top', { seo: { private: true, title: 'Autentificare — Vocea Locală Lenauheim' }, section: '' }) %>
<section class="auth glass">
<span class="eyebrow">ADMINISTRARE</span>
<h1>Intră în cont</h1>
<p class="muted">Pentru redacție (Super Admin) și pentru candidații care își administrează site-ul.</p>
<% if (mesaj) { %><p class="notice notice--ok" role="status"><%= mesaj %></p><% } %>
<% if (eroare) { %><p class="notice notice--error" role="alert"><%= eroare %></p><% } %>
<form method="POST" action="/login">
<label class="fld">Email<input type="email" name="email" required autofocus autocomplete="username"></label>
<label class="fld">Parola<input type="password" name="parola" required autocomplete="current-password"></label>
<button class="btn btn--dark btn--block" type="submit">Intră în cont</button>
</form>
<p class="muted"><a href="/parola-uitata">Am uitat parola</a></p>
<p class="muted">Accesul este permis numai conturilor activate de administrator. După 5 încercări greșite, contul este blocat temporar.</p>
</section>
<%- include('partials/vl-bottom', { section: '' }) %>
