<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= articol.continut.slice(0, 155) %>">
  <meta property="og:type" content="article">
  <meta property="og:title" content="<%= articol.titlu %>">
  <meta property="og:description" content="<%= articol.continut.slice(0, 155) %>">
  <meta property="og:url" content="<%= articolUrl %>">
  <% if (!preview) { %><link rel="canonical" href="<%= articolUrl %>"><% } %>
  <% if (articol.imagine_url) { %><meta property="og:image" content="<%= new URL(articol.imagine_url, pageUrl).toString() %>"><% } %>
  <meta name="twitter:card" content="summary_large_image">
  <title><%= articol.titlu %> — <%= user.nume_candidat %></title>
  <link rel="stylesheet" href="<%= stylesheetUrl %>">
  <link rel="stylesheet" href="/newspaper.css">
  <link rel="stylesheet" href="/candidate-site.css?v=20260911-ro-font1">
</head>
<body class="newspaper-body candidate-design">
  <div class="candidate-site-shell">
    <%- include('partials/candidate-header', { user, activeSection }) %>
    <% if (preview) { %><section class="private-preview-banner" role="status"><div><strong>Previzualizare privată</strong><span>Numai tu poți vedea această pagină. Materialul nu a fost publicat, distribuit sau numărat ca citire.</span></div><a class="btn" href="/dashboard/articol/<%= articol.id %>/edit">Continuă editarea</a></section><% } %>
    <main class="article-layout" id="candidate-main">
      <article class="article-content">
        <span class="article-label"><%= articol.categorie %></span>
        <h1><%= articol.titlu %></h1>
        <% if (articol.rezumat) { %><p class="article-deck"><%= articol.rezumat %></p><% } %>
        <div class="article-byline"><span><%= preview ? 'Autor' : 'Publicat de' %> <strong><%= user.nume_candidat %></strong></span><span><%= preview ? (articol.status === 'programat' ? `Programat: ${displayDate(articol.data_programata)}` : 'Ciornă nepublicată') : displayDate(publicationDate(articol)) %></span><span><%= articol.vizualizari || 0 %> afișări</span><% if (articol.generat_de_ai) { %><span class="pill ai">Creat cu ajutorul AI</span><% } %></div>
        <aside class="article-transparency" aria-label="Transparența materialului"><strong><%= electoralMode ? 'Material electoral · publicitate politică' : 'Material civic · conținut asumat' %></strong><p><% if (electoralMode) { %>Finanțat de <b><%= transparenta.finantat_de %></b> · <% } %>responsabil editorial: <b><%= transparenta.responsabil_editorial %></b>.</p><div><a href="/site/<%= user.subdomeniu %>/transparenta<%= preview ? '' : `?articol=${articol.id}` %>">Informații complete</a><% if (!preview) { %><a href="/site/<%= user.subdomeniu %>/articol/<%= articol.id %>/raporteaza">Raportează materialul</a><% } else { %><span>Datele vor fi arhivate în momentul publicării.</span><% } %></div></aside>
        <% if (articol.imagine_url) { %><figure class="article-figure"><img class="article-hero-image" src="<%= articol.imagine_url %>" alt="<%= articol.imagine_alt || articol.titlu %>" decoding="async" referrerpolicy="no-referrer">
          <% if (articol.imagine_legenda || articol.imagine_credit || articol.imagine_generata_ai) { %><figcaption><%= articol.imagine_legenda || '' %><% if (articol.imagine_credit) { %> · <%= articol.imagine_credit %><% } %><% if (articol.imagine_generata_ai) { %><span class="image-origin">Ilustrație generată cu AI; nu este o fotografie documentară.</span><% } %></figcaption><% } %>
        </figure><% } %>
        <div class="article-text"><% articol.continut.split('\n').filter(p => p.trim()).forEach(paragraf => { %><% if (paragraf.startsWith('## ')) { %><h2><%= paragraf.slice(3) %></h2><% } else { %><p><%= paragraf %></p><% } %><% }) %></div>
        <% if (!preview) { %><%- include('partials/engagement', { item: articol, publicUrl: articolUrl, reactionAction: `/site/${user.subdomeniu}/articol/${articol.id}/reactie` }) %>
        <section class="comments-section" id="comentarii">
          <h2>Comentarii<% if (commentsAvailable) { %> (<%= comentarii.length %>)<% } %></h2>
          <p class="note">Comentariile apar numai după aprobarea Super Adminului. Aprobarea nu confirmă afirmațiile autorului. Nu trimite date personale ale altor persoane.</p>
          <% if (commentSent) { %><p class="mesaj-succes" role="status">Comentariul a fost trimis pentru moderare. Nu este încă public.</p><% } %>
          <% if (commentError) { %><p class="eroare" role="alert"><%= commentError %></p><% } %>
          <% if (!commentsAvailable) { %><p class="eroare" role="status">Comentariile sunt temporar indisponibile. Articolul poate fi citit în continuare; reîncarcă pagina pentru a reîncerca.</p><% } %>
          <% if (commentsAvailable && !comentarii.length) { %><p>Nu există încă comentarii aprobate.</p><% } %>
          <% comentarii.forEach(c => { %><article class="public-comment"><header><strong><%= c.nume %></strong> <time datetime="<%= c.created_at %>"><%= displayDate(c.created_at) %></time></header><p><%= c.text %></p></article><% }) %>
          <% if (commentsAvailable) { %><form method="POST" action="/site/<%= user.subdomeniu %>/articol/<%= articol.id %>/comentarii" class="comment-form">
            <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
            <div class="spam-trap" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"></label></div>
            <label>Nume sau pseudonim public<input name="nume" maxlength="80" required value="<%= commentValues.nume || '' %>"></label>
            <label>Comentariu<textarea name="text" rows="5" minlength="3" maxlength="2000" required><%= commentValues.text || '' %></textarea></label>
            <label class="consent-label"><input type="checkbox" name="acord_publicare" required> Sunt de acord ca numele/pseudonimul și comentariul să fie afișate public după moderare.</label>
            <p class="note">Pentru protecția anti-spam folosim temporar un identificator pseudonim care se schimbă zilnic. Nu salvăm adresa IP în comentariu.</p>
            <button type="submit">Trimite spre moderare</button>
          </form><% } %>
        </section><% } else { %><aside class="preview-disabled-tools"><strong>Distribuirea, raportarea și comentariile sunt oprite în previzualizare.</strong><p>Aceste funcții vor deveni disponibile numai după publicarea materialului.</p></aside><% } %>
      </article>
      <aside class="article-aside"><div class="candidate-monogram"><%= user.nume_candidat.split(' ').map(p => p[0]).slice(0,2).join('') %></div><h2><%= user.nume_candidat %></h2><p><%= user.functie_candidatura || 'Candidat' %><br><%= [user.zona, user.judet].filter(Boolean).join(', ') %></p><a class="btn" href="/site/<%= user.subdomeniu %>">Vezi toate articolele</a><p><a href="/site/<%= user.subdomeniu %>/contact">Contact candidat</a></p><p><a href="/site/<%= user.subdomeniu %>/transparenta<%= preview ? '' : `?articol=${articol.id}` %>">Transparență</a></p><% if (!preview) { %><p><a href="/site/<%= user.subdomeniu %>/articol/<%= articol.id %>/raporteaza">Raportează materialul</a></p><% } %></aside>
    </main>
    <%- include('partials/candidate-footer', { user }) %>
  </div>
  <%- include('partials/cristianweb-credit') %>
</body>
</html>
