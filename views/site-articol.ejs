<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= articol.continut.slice(0, 155) %>">
  <title><%= articol.titlu %> — <%= user.nume_candidat %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="newspaper-body">
  <div class="newspaper-shell article-shell">
    <div class="newspaper-kicker"><span>PUBLICAȚIE ELECTORALĂ</span><span><%= [user.zona, user.judet].filter(Boolean).join(' · ') %></span></div>
    <header class="newspaper-header compact-header"><a href="/site/<%= user.subdomeniu %>" class="newspaper-logo"><span><%= user.nume_candidat.split(' ')[0] %></span><strong>JURNAL</strong></a><a class="back-link" href="/site/<%= user.subdomeniu %>">← Prima pagină</a></header>
    <main class="article-layout">
      <article class="article-content">
        <span class="article-label"><%= articol.categorie %></span>
        <h1><%= articol.titlu %></h1>
        <div class="article-byline"><span>Publicat de <strong><%= user.nume_candidat %></strong></span><span><%= new Date(articol.data_publicare).toLocaleDateString('ro-RO') %></span><span><%= articol.vizualizari || 0 %> citiri</span><% if (articol.generat_de_ai) { %><span class="pill ai">Generat cu AI</span><% } %></div>
        <% if (articol.imagine_url) { %><img class="article-hero-image" src="<%= articol.imagine_url %>" alt="Imagine pentru articolul <%= articol.titlu %>"><% } %>
        <div class="article-text"><% articol.continut.split('\n').filter(p => p.trim()).forEach(paragraf => { %><p><%= paragraf %></p><% }) %></div>
        <div class="share-box"><strong>Distribuie articolul</strong><div><a target="_blank" rel="noopener" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(articolUrl) %>">Facebook</a><button type="button" class="secondary" onclick="navigator.clipboard.writeText(location.href).then(() => this.textContent='Link copiat')">Copiază linkul</button></div></div>
      </article>
      <aside class="article-aside"><div class="candidate-monogram"><%= user.nume_candidat.split(' ').map(p => p[0]).slice(0,2).join('') %></div><h2><%= user.nume_candidat %></h2><p><%= user.functie_candidatura || 'Candidat' %><br><%= [user.zona, user.judet].filter(Boolean).join(', ') %></p><a class="btn" href="/site/<%= user.subdomeniu %>">Vezi toate articolele</a></aside>
    </main>
    <footer class="newspaper-footer"><p>Material electoral. Conținut publicat și asumat de candidat.</p><a href="/">VoceaCandidatului</a></footer>
  </div>
</body>
</html>
