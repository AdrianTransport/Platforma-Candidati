<!DOCTYPE html>
<html lang="ro">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Comentariile mele — Dashboard</title><link rel="stylesheet" href="<%= stylesheetUrl %>"></head>
<body><main class="app-shell app-shell-wide">
  <% const labels = { in_asteptare: 'În așteptare', aprobat: 'Aprobate', respins: 'Respinse', sters: 'Șterse logic' }; %>
  <div class="topbar"><div><span class="eyebrow">Candidat</span><h1>Comentariile mele</h1></div><a class="btn secondary" href="/dashboard">Înapoi la dashboard</a></div>
  <p class="note">Vezi și moderezi doar comentariile primite la propriile tale articole. Ștergerea logică ascunde definitiv comentariul de pe site, dar păstrează textul în istoric.</p>
  <nav class="moderation-tabs" aria-label="Status comentarii"><% Object.entries(labels).forEach(([key, label]) => { %><a class="btn <%= status === key ? '' : 'secondary' %>" href="/dashboard/comentarii?status=<%= key %>" <%- status === key ? 'aria-current="page"' : '' %>><%= label %> (<%= counts[key] %>)</a><% }) %></nav>
  <p><%= total %> comentarii · pagina <%= page %> din <%= pages %></p>
  <% if (!lista.length) { %><section class="card"><p>Nu există comentarii în această categorie.</p></section><% } %>
  <% lista.forEach(c => { %><article class="card moderation-card">
    <header><h2><%= c.nume %></h2><span class="note"><%= displayDate(c.created_at) %> · <%= labels[c.status] %></span></header>
    <p><%= c.articol?.titlu || 'Articol șters' %></p>
    <blockquote class="comment-text"><%= c.text %></blockquote>
    <% if (c.status !== 'sters') { %><form method="POST" action="/dashboard/comentarii/<%= c.articol_id %>/<%= c.id %>" class="publication-actions">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="version" value="<%= c.version %>">
      <button name="status" value="aprobat" type="submit">Aprobă</button><button name="status" value="respins" class="secondary" type="submit">Respinge</button><button name="status" value="sters" class="danger" type="submit" data-confirm="Ascunzi definitiv comentariul?">Șterge logic</button>
    </form><% } %>
  </article><% }) %>
  <nav class="moderation-tabs" aria-label="Paginare"><% if (page > 1) { %><a class="btn secondary" href="/dashboard/comentarii?status=<%= status %>&pagina=<%= page - 1 %>">← Pagina anterioară</a><% } %><% if (page < pages) { %><a class="btn secondary" href="/dashboard/comentarii?status=<%= status %>&pagina=<%= page + 1 %>">Pagina următoare →</a><% } %></nav>
</main><script src="/form-confirmations.js" defer></script></body></html>
