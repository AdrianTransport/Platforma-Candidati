<%- include('partials/vl-top', { seo: { private: true, title: 'Am uitat parola — Vocea Locală Lenauheim' }, section: '' }) %>
<section class="auth glass">
<a class="small" href="/login">← Înapoi la autentificare</a>
<h1>Am uitat parola</h1>
<% if (trimis) { %>
<p class="notice notice--ok" role="status">Dacă adresa introdusă corespunde unui cont de Super Admin, a fost trimis un email cu instrucțiuni de resetare. Verifică și folderul de spam.</p>
<% } else { %>
<p class="muted">Introdu adresa de email a contului de Super Admin. Dacă există, primești un link valabil o oră pentru a-ți seta o parolă nouă.</p>
<form method="POST" action="/parola-uitata">
<input type="hidden" name="csrf_token" value="<%= csrfToken %>">
<label class="fld">Email<input type="email" name="email" required autofocus autocomplete="email"></label>
<button class="btn btn--dark btn--block" type="submit">Trimite linkul de resetare</button>
</form>
<% } %>
</section>
<%- include('partials/vl-bottom', { section: '' }) %>
