<%- include('partials/pf-admin-head', { pageTitle: 'Anunțuri', active: 'anunturi' }) %>
<div class="pf-head">
<div><h1>Anunțuri</h1><p>Avizierul public. Anunțurile trimise de cititori apar pe site numai după ce le verifici.</p></div>
<div class="pf-actions"><a class="btn secondary" href="/anunturi" target="_blank" rel="noopener">Vezi avizierul ↗</a><a class="btn" href="/admin/anunturi/nou">+ Anunț nou</a></div>
</div>
<section class="pf-section">
<div class="pf-section__head"><h2>De verificat (<%= pending.length %>)</h2></div>
<div class="pf-section__body pf-list">
<% for (const a of pending) { %>
<div class="pf-item">
<span class="pf-item__main"><span class="pf-item__meta"><%= adTypeName(a.tip) %> · trimis <%= t.formatDate(a.createdAt) %> <%= t.formatTime(a.createdAt) %><% if (a.telefon) { %> · tel. <%= a.telefon %><% } %></span><b><%= a.titlu %></b><span class="pf-item__text"><%= a.text %></span><% if (a.poze?.length) { %><span class="pf-hint"><%= a.poze.length %> <%= a.poze.length === 1 ? 'poză' : 'poze' %> de verificat</span><% } %><%- include('partials/pf-ad-photos', { ad: a, back: 'lista' }) %></span>
<span class="pf-actions"><a class="btn" href="/admin/anunturi/<%= a.id %>">Verifică și publică</a><form method="POST" action="/admin/anunturi/<%= a.id %>/sterge" data-confirm="Respingi și ștergi definitiv acest anunț?"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button class="danger" type="submit">Respinge</button></form></span>
</div>
<% } %>
<% if (!pending.length) { %><p class="pf-hint">Niciun anunț de verificat.</p><% } %>
</div>
</section>
<section class="pf-section">
<div class="pf-section__head"><h2>Publicate (<%= published.length %>)</h2></div>
<div class="pf-section__body pf-list">
<% for (const a of published) { %>
<div class="pf-item">
<span class="pf-item__main"><span class="pf-item__meta"><%= adTypeName(a.tip) %> · <%= t.formatDate(a.publicatLa) %><% if (a.expiraLa) { %> · <%= expired(a) ? 'expirat' : 'expiră ' + t.formatDate(a.expiraLa) %><% } %></span><a href="/admin/anunturi/<%= a.id %>"><b><%= a.titlu %></b></a><%- include('partials/pf-ad-photos', { ad: a, back: 'lista' }) %></span>
<span class="pf-actions"><% if (a.important) { %><span class="pf-badge pf-badge--live">IMPORTANT</span><% } %><form method="POST" action="/admin/anunturi/<%= a.id %>/sterge" data-confirm="Ștergi definitiv acest anunț?"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><button class="danger" type="submit">Șterge</button></form></span>
</div>
<% } %>
<% if (!published.length) { %><p class="pf-hint">Niciun anunț publicat.</p><% } %>
</div>
</section>
<script src="/form-confirmations.js" defer></script>
<%- include('partials/pf-admin-bottom') %>
</body>
</html>
