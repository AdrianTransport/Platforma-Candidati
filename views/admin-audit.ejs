<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Jurnal de conformitate — Super Admin</title>
  <link rel="stylesheet" href="<%= stylesheetUrl %>">
</head>
<body>
  <main class="app-shell app-shell-wide">
    <div class="topbar"><div><span class="eyebrow">Trasabilitate</span><h1>Jurnal de conformitate</h1></div><a class="btn secondary" href="/admin">Înapoi la administrare</a></div>
    <p class="note">Ultimele 100 de evenimente. Jurnalul păstrează acțiunile de activare, configurare, publicare și soluționare; nu conține parole sau adrese IP brute.</p>
    <% const labels = { terms_accepted:'Termeni acceptați', candidate_created:'Cont candidat creat', candidate_status_changed:'Stare cont schimbată', candidate_configuration_changed:'Configurare contractuală schimbată', candidate_profile_changed:'Profil public schimbat', article_created:'Articol creat', article_updated:'Articol actualizat', article_deleted:'Articol șters', report_submitted:'Sesizare primită', report_in_analiza:'Sesizare în analiză', report_continut_suspendat:'Conținut suspendat', report_respinsa:'Sesizare respinsă', report_inchisa:'Sesizare închisă' }; %>
    <% if (!events.length) { %><section class="card"><p>Nu există încă evenimente în jurnal.</p></section><% } %>
    <div class="card responsive-table"><table class="audit-table"><thead><tr><th>Data</th><th>Acțiunea</th><th>Actor</th><th>Ținta</th><th>Detalii</th></tr></thead><tbody>
      <% events.forEach(event => { %><tr>
        <td><%= displayDate(event.created_at) %></td>
        <td><strong><%= labels[event.action] || event.action %></strong></td>
        <td><%= event.actor_role %><% if (event.actor_id) { %> #<%= event.actor_id %><% } %></td>
        <td><%= event.target_type || '—' %><% if (event.target_id) { %> #<%= event.target_id %><% } %></td>
        <td><code><%= JSON.stringify(event.details || {}) %></code></td>
      </tr><% }) %>
    </tbody></table></div>
  </main>
</body>
</html>
