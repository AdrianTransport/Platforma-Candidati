<%- include('partials/vl-top', { seo, section: 'stiri', blobs: 'stiri' }) %>
<nav class="crumbs" aria-label="Cale"><a href="/">Prima pagină</a> / <a href="/sectiune/stiri">Știri</a> / <%= post.categorie || 'Actualitate' %></nav>
<article class="article">
<header class="article__head">
<div class="article__meta"><span class="chip <%= post.tip === 'campanie' ? 'cat-campanie' : 'cat-' + toneOf(post.categorie) %>"><%= post.tip === 'campanie' ? 'CAMPANIE CANDIDAT' : (post.categorie || 'Actualitate') %></span><time<% if (seo.publishedAt) { %> datetime="<%= seo.publishedAt %>"<% } %>><%= displayDate(portalPublicationDate(post)) %></time><span><%= post.vizualizari || 0 %> citiri</span></div>
<h1><%= post.titlu %></h1>
<% if (post.rezumat) { %><p class="article__lead"><%= post.rezumat %></p><% } %>
</header>
<% if (post.imagine_url) { %><figure class="article__figure"><img src="<%= post.imagine_url %>" alt="<%= post.imagine_alt || '' %>" width="1200" height="800" decoding="async" fetchpriority="high"><% if (post.imagine_legenda || post.imagine_credit || post.imagine_generata_ai) { %><figcaption><%= [post.imagine_legenda, post.imagine_credit && `Foto: ${post.imagine_credit}`, post.imagine_generata_ai && 'Ilustrație generată cu AI'].filter(Boolean).join(' · ') %></figcaption><% } %></figure><% } %>
<div class="prose"><% post.continut.split('\n').filter(line => line.trim()).forEach(line => { %><% if (line.startsWith('## ')) { %><h2><%= line.slice(3) %></h2><% } else { %><p><%= line %></p><% } %><% }) %></div>
<aside class="box glass transparency" aria-label="Transparență">
<span class="eyebrow">TRANSPARENȚĂ</span>
<% if (post.tip === 'campanie' && candidat) { %>
<h2><%= candidat.nume_candidat %></h2><p class="muted"><%= candidat.functie_candidatura %><% if (candidat.zona || candidat.judet) { %> · <%= [candidat.zona, candidat.judet].filter(Boolean).join(', ') %><% } %></p>
<dl><dt>Responsabil editorial</dt><dd><%= post.transparenta?.responsabil_editorial || candidat.entitate_responsabila %></dd><dt>Finanțat de</dt><dd><%= post.transparenta?.finantat_de || post.finantator %></dd><dt>Scrutin</dt><dd><%= post.transparenta?.scrutin || candidat.scrutin %></dd><dt>Cod mandatar</dt><dd><%= post.transparenta?.cod_mandatar_financiar || candidat.cod_mandatar_financiar %></dd></dl>
<a class="btn btn--dark" href="/site/<%= candidat.subdomeniu %>">Vezi publicația candidatului</a>
<% } else { %>
<h2><%= platform.name %></h2><p class="muted">Știre publicată și asumată editorial de <strong><%= portalEditorialResponsible %></strong>.<% if (isLenauheimCivicPortal) { %> Material al inițiativei civice personale.<% } %> <a href="/legal/continut">Politica editorială și dreptul la replică</a>.</p>
<% } %>
</aside>
<% if (share) { %><%- include('partials/vl-share', { share }) %><% } %>
<%- include('partials/engagement', { item: post, publicUrl: postUrl, reactionAction: `/actualitate/${post.slug}/reactie`, hideShare: Boolean(share) }) %>
<% if (post.generat_de_ai) { %><p class="muted small">Text redactat cu ajutorul OpenAI și verificat de editor înainte de publicare.</p><% } %>
</article>
<%- include('partials/vl-bottom', { section: 'stiri' }) %>
